+static int s5kjn5_get_mbus_config(struct v4l2_subdev *sd, unsigned int pad,
+				  struct v4l2_mbus_config *cfg)
+{
+	if (pad != 0)
+		return -EINVAL;
+
+	cfg->type = V4L2_MBUS_CSI2_CPHY;
+	cfg->link_freq = S5KJN5_CPHY_LINK_FREQ;
+	cfg->bus.mipi_csi2.num_data_lanes = S5KJN5_DATA_LANES;
+	cfg->bus.mipi_csi2.t_prepare_ns = S5KJN5_CPHY_PREPARE_NS;
+	cfg->bus.mipi_csi2.t_preamble_ns = S5KJN5_CPHY_PREAMBLE_NS;
+
+	return 0;
+}
