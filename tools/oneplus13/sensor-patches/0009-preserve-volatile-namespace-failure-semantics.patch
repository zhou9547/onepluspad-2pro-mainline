@@ -200,20 +224,27 @@
 static inline int pr_rename(struct phone_ramfs *fs,const char *old_name,const char *new_name)
 {
     char old_path[PR_NAME_MAX],new_path[PR_NAME_MAX];
-    unsigned int source,target;
+    unsigned int source,target,i;
     int ret;
     if(!fs->enabled) return EINVAL;
     ret=pr_canonical_name(old_name,old_path);if(ret) return ret;
     ret=pr_canonical_name(new_name,new_path);if(ret) return ret;
     if(!strcmp(old_path,new_path)) return pr_find(fs,old_path)>=0?0:ENOENT;
-    ret=pr_slot(fs,old_path,&source);if(ret) return ret;
-    if(!fs->files[source].present) return ENOENT;
-    ret=pr_find(fs,new_path);
+    ret=pr_find(fs,old_path);if(ret<0) return -ret;
+    source=(unsigned int)ret;
+    ret=pr_named_slot(fs,new_path);
     if(ret>=0) {
         target=(unsigned int)ret;
         if(pr_file_has_handles(fs,target)) return EBUSY;
-        pr_reset_file(fs,&fs->files[target]);
+    } else {
+        for(i=0;i<PR_FILES;i++) if(fs->files[i].name[0]=='\0') break;
+        if(i==PR_FILES) return EMFILE;
+        target=i;
     }
+    /* All refusal conditions precede this commit point. Keep source handles. */
+    pr_reset_file(fs,&fs->files[target]);
+    strcpy(fs->files[target].name,old_path);
+    fs->files[target].tombstone=true;
     strcpy(fs->files[source].name,new_path);return 0;
 }
 static inline void pr_destroy(struct phone_ramfs *fs)
--- a/tests/test_phone_ramfs.c
+++ b/tests/test_phone_ramfs.c
@@ -4,6 +4,32 @@
 #include "../hexagonrpcd/phone_ramfs.h"
 #define CHECK(x) do { if(!(x)) { fprintf(stderr,"ramfs:%d: %s\n",__LINE__,#x);exit(1); } } while(0)
 static void *deny_resize(void *old,size_t size) { (void)old;(void)size;return NULL; }
+static void namespace_failures(void)
+{
+    struct phone_ramfs fs={.enabled=true};
+    char old_name[PR_NAME_MAX];
+    unsigned int i;
+    /* Rejected lookups must not exhaust the finite name table. */
+    for(i=0;i<PR_FILES+1;i++) {
+        snprintf(old_name,sizeof(old_name),"missing-%u",i);
+        CHECK(pr_rename(&fs,old_name,"target")==ENOENT);
+    }
+    for(i=0;i<PR_FILES;i++) CHECK(fs.files[i].name[0]=='\0');
+    fs.resize=deny_resize;
+    CHECK(pr_seed(&fs,pr_names[0],"x",1)==ENOMEM);
+    for(i=0;i<PR_FILES;i++) CHECK(fs.files[i].name[0]=='\0');
+    CHECK(fs.total_capacity==0);
+    fs.resize=NULL;
+    CHECK(pr_seed(&fs,pr_names[0],"x",1)==0);
+    for(i=1;i<PR_FILES;i++) {
+        unsigned int index;
+        snprintf(old_name,sizeof(old_name),"reserved-%u",i);
+        CHECK(pr_slot(&fs,old_name,&index)==0);
+    }
+    CHECK(pr_rename(&fs,pr_names[0],"no-space")==EMFILE);
+    CHECK(pr_find(&fs,pr_names[0])==0 && fs.files[0].size==1 && fs.files[0].data[0]=='x');
+    pr_destroy(&fs);
+}
 int main(void)
 {
