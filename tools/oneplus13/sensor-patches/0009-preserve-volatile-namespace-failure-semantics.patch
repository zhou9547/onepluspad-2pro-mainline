--- a/hexagonrpcd/phone_ramfs.h
+++ b/hexagonrpcd/phone_ramfs.h
@@ -15,7 +15,7 @@
 #define PR_HANDLES 64u
 #define PR_GEN_MAX 0x3fffffu
