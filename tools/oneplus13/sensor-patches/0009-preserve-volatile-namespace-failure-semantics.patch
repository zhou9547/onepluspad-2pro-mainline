+/* Includes deleted names: a rename must mask the immutable source snapshot. */
+static inline int pr_named_slot(struct phone_ramfs *fs,const char *name)
+{
+    char canonical[PR_NAME_MAX];
+    unsigned int i;
+    int ret=pr_canonical_name(name,canonical);
+    if(ret) return -ret;
+    for(i=0;i<PR_FILES;i++)
+        if(!strcmp(fs->files[i].name,canonical)) return (int)i;
+    return -ENOENT;
+}
+static inline bool pr_handle_available(struct phone_ramfs *fs)
+{
+    unsigned int i;
+    for(i=0;i<PR_HANDLES;i++)
+        if(!fs->handles[i].active && fs->handles[i].generation<PR_GEN_MAX) return true;
+    return false;
+}
 static inline bool pr_namespace(uint32_t handle) { return (handle & 0xc0000000u)==0x40000000u; }
 static inline struct pr_handle *pr_get(struct phone_ramfs *fs,uint32_t handle)
 {
@@ -117,11 +135,17 @@
 static inline int pr_seed(struct phone_ramfs *fs,const char *name,const void *data,size_t size)
 {
     unsigned int index;
-    int ret;
+    int ret,previous;
     if(!fs->enabled || (size && !data)) return EINVAL;
+    previous=pr_named_slot(fs,name);
     ret=pr_slot(fs,name,&index);if(ret) return ret;
     if(fs->files[index].present) return EEXIST;
-    ret=pr_reserve(fs,&fs->files[index],size);if(ret) return ret;
+    if(fs->files[index].tombstone) return ENOENT;
+    ret=pr_reserve(fs,&fs->files[index],size);
+    if(ret) {
+        if(previous<0) pr_reset_file(fs,&fs->files[index]);
+        return ret;
+    }
     if(size) memcpy(fs->files[index].data,data,size);
     fs->files[index].size=size;fs->files[index].present=true;return 0;
 }
