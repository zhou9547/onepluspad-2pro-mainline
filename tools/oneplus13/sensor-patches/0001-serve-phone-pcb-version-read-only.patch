From: Codex <codex@openai.com>
Subject: [PATCH] hexagonrpcd: map staged phone PCB identity read-only

The phone sensor firmware requests /proc/oplusVersion/pcbVersion. Serve only
<device-root>/board/pcbVersion through the existing read-only mapped backend.
Missing inputs stay ENOENT, no value is supplied by this patch and no host
/proc tree is exposed. This supplemental patch is applied only by the phone
offline builder; the shared Pad recipe and its original five patches stay
unchanged. No writable registry, DSP library or sensor stream is added.

Cover absence, exact bytes, EOF/seek/reopen semantics, neighboring names and
host-proc/traversal refusal with synthetic C inputs.

--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -34,6 +34,7 @@
 #define SNS_REG_CONFIG		"/sensors/sns_reg.conf"
 #define ODM_SENSORS_CONFIG	"/sensors/odm-config/"
 #define SYSFS_SOCINFO		"/socinfo/"
+#define PHONE_PCB_VERSION	"/board/pcbVersion"
 
 static struct hexagonfs_dirent *hfs_mkdir(const char *name, size_t n_ents, ...)
 {
@@ -114,7 +115,7 @@
 struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 {
 	char *acdbdata, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_version,
-	     *sns_reg_config, *odm_sns_cfg, *socinfo;
+	     *sns_reg_config, *odm_sns_cfg, *socinfo, *pcb_version;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
@@ -127,6 +128,7 @@
 	sns_reg_config = malloc(n_prefix + strlen(SNS_REG_CONFIG) + 1);
 	odm_sns_cfg = malloc(n_prefix + strlen(ODM_SENSORS_CONFIG) + 1);
 	socinfo = malloc(n_prefix + strlen(SYSFS_SOCINFO) + 1);
+	pcb_version = malloc(n_prefix + strlen(PHONE_PCB_VERSION) + 1);
 
 	dsp_libs = malloc(n_prefix + strlen(DSP_LIBS) + strlen(dsp) + 1);
 
@@ -163,6 +165,11 @@
 	if (socinfo != NULL) {
 		strcpy(socinfo, prefix);
 		strcat(socinfo, SYSFS_SOCINFO);
+	}
+
+	if (pcb_version != NULL) {
+		strcpy(pcb_version, prefix);
+		strcat(pcb_version, PHONE_PCB_VERSION);
 	}
 
 	if (dsp_libs != NULL) {
@@ -202,13 +209,19 @@
 	 * Some vendor sensor firmware reads a second, device-specific JSON
 	 * directory from the ODM partition in addition to the vendor one.
 	 */
-	return hfs_mkdir("/", 7,
+	return hfs_mkdir("/", 8,
 			hfs_mkdir("mnt", 1,
 				hfs_mkdir("vendor", 1,
 					persist_dir
 				)
 			),
 			persist_dir,
+			/* No host /proc passthrough: only the staged board value. */
+			hfs_mkdir("proc", 1,
+				hfs_mkdir("oplusVersion", 1,
+					hfs_map("pcbVersion", pcb_version)
+				)
+			),
 			hfs_mkdir("odm", 1,
 				hfs_mkdir("etc", 1,
 					hfs_mkdir("sensor", 1,
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -108,3 +108,16 @@
   args : [meson.current_build_dir() / 'apps-std-fd'])
 test('listener-refusal', test_listener_refusal,
   args : [meson.current_build_dir() / 'listener-refusal'])
+
+test_phone_pcb_version = executable('test_phone_pcb_version',
+  'test_phone_pcb_version.c',
+  '../hexagonrpcd/rpcd_builder.c',
+  '../hexagonrpcd/hexagonfs.c',
+  '../hexagonrpcd/hexagonfs_mapped.c',
+  '../hexagonrpcd/hexagonfs_plat_subtype_name.c',
+  '../hexagonrpcd/hexagonfs_virt_dir.c',
+  c_args : cflags,
+  include_directories : include,
+)
+test('phone-pcb-version', test_phone_pcb_version,
+  args : [meson.current_build_dir()])
--- /dev/null
+++ b/tests/test_phone_pcb_version.c
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Synthetic data only; no phone identities, registry or FastRPC device. */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "../hexagonrpcd/hexagonfs.h"
+#include "../hexagonrpcd/rpcd_builder.h"
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "phone-board check failed at %d\n", __LINE__); return 1; } } while (0)
+int main(int argc, char **argv)
+{
+    struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD] = {0};
+    struct hexagonfs_dirent *root;
+    struct stat stats;
+    char temp[4096], board[4096], file[4096], data[64] = {0};
+    const char expected[] = "SYNTHETIC-PCB\n";
+    int rootfd, fd, hostfd, n;
+    CHECK(argc == 2);
+    n = snprintf(temp, sizeof(temp), "%s/phone-board-XXXXXX", argv[1]);
+    CHECK(n > 0 && (size_t)n < sizeof(temp));
+    CHECK(mkdtemp(temp) != NULL);
+    root = construct_root_dir(temp, "adsp");
+    CHECK(root != NULL);
+    rootfd = hexagonfs_open_root(fds, root);
+    CHECK(rootfd >= 0);
+    fd = hexagonfs_openat(fds, rootfd, rootfd, "/proc/oplusVersion/pcbVersion");
+    CHECK(fd == -ENOENT);
+    n = snprintf(board, sizeof(board), "%s/board", temp);
+    CHECK(n > 0 && (size_t)n < sizeof(board));
+    CHECK(mkdir(board, 0700) == 0);
+    n = snprintf(file, sizeof(file), "%s/pcbVersion", board);
+    CHECK(n > 0 && (size_t)n < sizeof(file));
+    hostfd = open(file, O_WRONLY | O_CREAT | O_EXCL, 0600);
+    CHECK(hostfd >= 0);
+    CHECK(write(hostfd, expected, sizeof(expected)-1) == (ssize_t)sizeof(expected)-1);
+    CHECK(close(hostfd) == 0);
+    fd = hexagonfs_openat(fds, rootfd, rootfd, "/proc/oplusVersion/pcbVersion");
+    CHECK(fd >= 0);
+    CHECK(hexagonfs_fstat(fds, fd, &stats) == 0 && S_ISREG(stats.st_mode));
+    CHECK(hexagonfs_read(fds, fd, sizeof(data), data) == (ssize_t)sizeof(expected)-1);
+    CHECK(memcmp(data, expected, sizeof(expected)-1) == 0);
+    CHECK(hexagonfs_read(fds, fd, sizeof(data), data) == 0);
+    CHECK(hexagonfs_lseek(fds, fd, 0, SEEK_SET) == 0);
+    CHECK(hexagonfs_read(fds, fd, sizeof(data), data) == (ssize_t)sizeof(expected)-1);
+    CHECK(hexagonfs_close(fds, fd) == 0);
+    CHECK(hexagonfs_openat(fds, rootfd, rootfd, "/proc/oplusVersion/pcbVersion-extra") == -ENOENT);
+    CHECK(hexagonfs_openat(fds, rootfd, rootfd, "/proc/sys/kernel/hostname") == -ENOENT);
+    CHECK(hexagonfs_openat(fds, rootfd, rootfd, "/proc/oplusVersion/../../etc/passwd") == -ENOENT);
+    CHECK(stat(file, &stats) == 0 && stats.st_size == (off_t)sizeof(expected)-1);
+    CHECK((stats.st_mode & 0777) == 0600);
+    CHECK(hexagonfs_close(fds, rootfd) == 0);
+    puts("PHONE_PCB_VERSION_READ_ONLY_MAPPING_OK");
+    return 0;
+}
