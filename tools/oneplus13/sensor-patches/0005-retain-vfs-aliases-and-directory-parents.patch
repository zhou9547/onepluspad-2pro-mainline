From: Codex <codex@openai.com>
Subject: [PATCH] hexagonfs: retain aliased descriptors and their parents

The original apps_std test explicitly avoided deinit because directory
descriptor cleanup double-frees shared ancestry. Account separately for
assigned file numbers and child nodes. An alias close only removes that
assignment; a parent stays alive until its final child is gone. Temporary
path traversal pops release only their leaf and decrement the parent's child
count. Reject invalid root/directory numbers before dereferencing them.

The new real VFS test covers alias and ancestor closes, descriptor exhaustion,
temporary pops and reuse; the original apps_std test now actually deinitializes
its context. No original wire assertions are removed. This precedes any mutable
RAM backend and adds no host writable filesystem operation.

--- a/hexagonrpcd/hexagonfs.h
+++ b/hexagonrpcd/hexagonfs.h
@@ -57,6 +57,8 @@
 
 struct hexagonfs_fd {
 	bool is_assigned;
+	size_t assignments;
+	size_t children;
 	struct hexagonfs_fd *up;
 	void *data;
 
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -70,7 +70,8 @@
 	if (dir != root && dir->up != NULL) {
 		up = dir->up;
 
-		if (!dir->is_assigned) {
+		if (!dir->is_assigned && dir->children == 0) {
+			up->children--;
 			dir->ops->close(dir->data);
 			free(dir);
 		}
@@ -89,6 +90,7 @@
 	for (i = 0; i < HEXAGONFS_MAX_FD; i++) {
 		if (fds[i] == NULL) {
 			fd->is_assigned = true;
+			fd->assignments++;
 			fds[i] = fd;
 			return i;
 		}
@@ -102,11 +104,14 @@
 	struct hexagonfs_fd *curr = fd;
 	struct hexagonfs_fd *next;
 
-	while (curr != NULL && !curr->is_assigned) {
+	while (curr != NULL && !curr->is_assigned && curr->children == 0) {
 		next = curr->up;
-		curr->ops->close(curr->data);
+		if (curr->data != NULL)
+			curr->ops->close(curr->data);
 		free(curr);
 
+		if (next != NULL)
+			next->children--;
 		curr = next;
 	}
 }
@@ -121,6 +126,9 @@
 		return -ENOMEM;
 
 	fd->is_assigned = false;
+	fd->assignments = 0;
+	fd->children = 0;
+	fd->data = NULL;
 	fd->up = NULL;
 	fd->ops = root->ops;
 
@@ -141,13 +149,17 @@
 
 int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
 {
-	struct hexagonfs_fd *fd;
+	struct hexagonfs_fd *fd, *parent;
 	const char *curr = name;
 	char *segment;
 	bool expect_dir;
 	int selected = dirfd;
 	int ret = 0;
 
+	if (rootfd < 0 || rootfd >= HEXAGONFS_MAX_FD || !fds[rootfd]
+	 || dirfd < 0 || dirfd >= HEXAGONFS_MAX_FD || !fds[dirfd] || !name)
+		return -EBADF;
+
 	if (*curr == '/') {
 		selected = rootfd;
 
@@ -169,7 +181,13 @@
 		} else if (!strcmp(segment, "..")) {
 			fd = pop_dir(fd, fds[rootfd]);
 		} else {
+			parent = fd;
 			ret = fd->ops->openat(fd, segment, expect_dir, &fd);
+			if (!ret) {
+				fd->assignments = 0;
+				fd->children = 0;
+				parent->children++;
+			}
 		}
 
 	next:
@@ -180,7 +198,7 @@
 		goto err;
 
 	ret = allocate_file_number(fds, fd);
-	if (ret)
+	if (ret < 0)
 		goto err;
 
 	return ret;
@@ -202,7 +220,8 @@
 	if (fd == NULL || fd->ops == NULL)
 		return -EBADF;
 
-	fd->is_assigned = false;
+	fd->assignments--;
+	fd->is_assigned = fd->assignments != 0;
 	destroy_file_descriptor(fd);
 
 	fds[fileno] = NULL;
--- /dev/null
+++ b/tests/test_hexagonfs_lifetime.c
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../hexagonrpcd/hexagonfs.h"
+#define CHECK(x) do { if(!(x)) { fprintf(stderr,"lifetime:%d: %s\n",__LINE__,#x); exit(1); } } while(0)
+static unsigned int closed;
+static struct hexagonfs_file_ops ops;
+static void close_node(void *data) { closed++;free(data); }
+static int from_entry(const void *unused,bool dir,void **data)
+{ (void)unused;(void)dir;*data=malloc(1);return *data?0:-ENOMEM; }
+static int child(struct hexagonfs_fd *parent,const char *segment,bool directory,struct hexagonfs_fd **out)
+{
+    struct hexagonfs_fd *node;
+    (void)directory;
+    if(!strcmp(segment,"missing")) return -ENOENT;
+    node=malloc(sizeof(*node));if(!node) return -ENOMEM;
+    node->data=malloc(1);if(!node->data) { free(node);return -ENOMEM; }
+    node->is_assigned=false;node->up=parent;node->ops=&ops;*out=node;return 0;
+}
+static ssize_t read_node(struct hexagonfs_fd *fd,size_t size,void *out)
+{ (void)fd;if(size) *(char *)out='X';return size?1:0; }
+int main(void)
+{
+    struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD]={0};
+    struct hexagonfs_dirent root={.ops=&ops};
+    int r,d,a,f,i,aliases[HEXAGONFS_MAX_FD];char byte=0;
+    ops=(struct hexagonfs_file_ops){.close=close_node,.from_dirent=from_entry,.openat=child,.read=read_node};
+    r=hexagonfs_open_root(fds,&root);CHECK(r==0);
+    d=hexagonfs_openat(fds,r,r,"dir");CHECK(d==1);
+    a=hexagonfs_openat(fds,r,d,".");CHECK(a==2);
+    f=hexagonfs_openat(fds,r,d,"file");CHECK(f==3);
+    CHECK(hexagonfs_close(fds,d)==0);
+    CHECK(closed==0); /* An alias and a child still own the same directory. */
+    CHECK(hexagonfs_close(fds,r)==0 && closed==0);
+    CHECK(hexagonfs_close(fds,a)==0 && closed==0);
+    CHECK(hexagonfs_read(fds,f,1,&byte)==1 && byte=='X');
+    CHECK(hexagonfs_close(fds,f)==0 && closed==3);
+    CHECK(hexagonfs_close(fds,f)==-EBADF);
+    CHECK(hexagonfs_openat(fds,-1,0,"x")==-EBADF);
+    CHECK(hexagonfs_openat(fds,0,HEXAGONFS_MAX_FD,"x")==-EBADF);
+    /* Exhaustion cannot free or unassign any of the existing aliases. */
+    r=hexagonfs_open_root(fds,&root);CHECK(r==0);
+    for(i=0;i<HEXAGONFS_MAX_FD-1;i++) {
+        aliases[i]=hexagonfs_openat(fds,r,r,"/");CHECK(aliases[i]==i+1);
+    }
+    CHECK(hexagonfs_openat(fds,r,r,"/")==-EMFILE && closed==3);
+    CHECK(hexagonfs_openat(fds,r,r,"new-child")==-EMFILE && closed==4);
+    CHECK(hexagonfs_openat(fds,r,r,NULL)==-EBADF);
+    CHECK(hexagonfs_close(fds,r)==0 && closed==4);
+    for(i=0;i<HEXAGONFS_MAX_FD-1;i++) CHECK(hexagonfs_close(fds,aliases[i])==0);
+    CHECK(closed==5);
+    /* Traversal pop frees only the temporary child, retaining its parent. */
+    r=hexagonfs_open_root(fds,&root);CHECK(r==0);
+    a=hexagonfs_openat(fds,r,r,"dir/..");CHECK(a==1 && closed==6);
+    CHECK(hexagonfs_openat(fds,r,r,"temp/missing")==-ENOENT && closed==7);
+    CHECK(hexagonfs_close(fds,r)==0 && closed==7);
+    CHECK(hexagonfs_close(fds,a)==0 && closed==8);
+    puts("VFS_ALIAS_PARENT_CHILD_EXHAUSTION_POP_LIFETIME_PASS");return 0;
+}
--- a/tests/test_apps_std_fd.c
+++ b/tests/test_apps_std_fd.c
@@ -289,10 +289,7 @@
 	test_rejections();
 	test_fopen_with_env_unchanged();
 
-	/*
-	 * Not deinitialized: fastrpc_apps_std_deinit() double-frees the shared
-	 * directory descriptors even right after init; the daemon only calls it
-	 * on a failed start.
-	 */
+	fastrpc_apps_std_deinit(apps_std);
+
 	return 0;
 }
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -130,3 +130,11 @@
 )
 
 test('input-type-sequence', test_input_type_sequence)
+
+test_hexagonfs_lifetime = executable('test_hexagonfs_lifetime',
+  'test_hexagonfs_lifetime.c',
+  '../hexagonrpcd/hexagonfs.c',
+  c_args : cflags,
+  include_directories : include,
+)
+test('hexagonfs-lifetime', test_hexagonfs_lifetime)
