 	     *cam_registry, *sns_reg_config, *odm_sns_cfg, *socinfo,
-	     *pcb_version;
+	     *pcb_version, *camera_info;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
@@ -132,6 +133,9 @@
 	odm_sns_cfg = malloc(n_prefix + strlen(ODM_SENSORS_CONFIG) + 1);
 	socinfo = malloc(n_prefix + strlen(SYSFS_SOCINFO) + 1);
 	pcb_version = malloc(n_prefix + strlen(PHONE_PCB_VERSION) + 1);
+	camera_info = malloc(n_prefix + strlen(PHONE_CAMERA_INFO) + 1);
+	if (camera_info == NULL)
+		return NULL;
 
 	dsp_libs = malloc(n_prefix + strlen(DSP_LIBS) + strlen(dsp) + 1);
 
@@ -178,6 +182,10 @@
 	if (pcb_version != NULL) {
 		strcpy(pcb_version, prefix);
 		strcat(pcb_version, PHONE_PCB_VERSION);
+	}
+	if (camera_info != NULL) {
+		strcpy(camera_info, prefix);
+		strcat(camera_info, PHONE_CAMERA_INFO);
 	}
 
 	if (dsp_libs != NULL) {
@@ -190,7 +198,10 @@
 	 * Some platforms need this in / and some need it in /mnt/vendor. Form
 	 * a hard link between both locations.
 	 */
-	persist_dir = hfs_mkdir("persist", 1,
+	persist_dir = hfs_mkdir("persist", 2,
