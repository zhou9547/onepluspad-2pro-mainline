--- /dev/null
+++ b/tests/test_phone_camera_info.c
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Synthetic binary only. No camera activation, calibration or device access. */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "../hexagonrpcd/hexagonfs.h"
+#include "../hexagonrpcd/rpcd_builder.h"
+#define CHECK(x) do { if(!(x)) { fprintf(stderr,"phone-camera:%d\n",__LINE__);return 1; } } while(0)
+int main(int argc,char **argv)
+{
+    struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD]={0};
+    struct hexagonfs_dirent *root;
+    struct stat stats;
+    static const unsigned char expected[]={0x00,0x53,0x59,0x4e,0x54,0xff,0x0a};
+    unsigned char actual[32];
+    char temp[4096],directory[4096],file[4096];
+    const char *name="/mnt/vendor/persist/camera/Rear_third_camera_info.bin";
+    int rootfd,fd,hostfd,n;
+    CHECK(argc==2);
+    n=snprintf(temp,sizeof(temp),"%s/phone-camera-XXXXXX",argv[1]);
+    CHECK(n>0 && (size_t)n<sizeof(temp) && mkdtemp(temp));
+    root=construct_root_dir(temp,"adsp");CHECK(root);
+    rootfd=hexagonfs_open_root(fds,root);CHECK(rootfd>=0);
+    CHECK(hexagonfs_openat(fds,rootfd,rootfd,name)==-ENOENT);
+    n=snprintf(directory,sizeof(directory),"%s/camera",temp);
+    CHECK(n>0 && (size_t)n<sizeof(directory) && mkdir(directory,0700)==0);
+    n=snprintf(file,sizeof(file),"%s/Rear_third_camera_info.bin",directory);
+    CHECK(n>0 && (size_t)n<sizeof(file));
+    hostfd=open(file,O_WRONLY|O_CREAT|O_EXCL,0600);CHECK(hostfd>=0);
+    CHECK(write(hostfd,expected,sizeof(expected))==(ssize_t)sizeof(expected));
+    CHECK(close(hostfd)==0);
+    fd=hexagonfs_openat(fds,rootfd,rootfd,name);CHECK(fd>=0);
+    CHECK(hexagonfs_fstat(fds,fd,&stats)==0 && stats.st_size==(off_t)sizeof(expected));
+    CHECK((stats.st_mode&0222)==0 && S_ISREG(stats.st_mode));
+    CHECK(hexagonfs_read(fds,fd,sizeof(actual),actual)==(ssize_t)sizeof(expected));
+    CHECK(memcmp(actual,expected,sizeof(expected))==0);
+    CHECK(hexagonfs_read(fds,fd,sizeof(actual),actual)==0);
+    CHECK(hexagonfs_lseek(fds,fd,0,SEEK_SET)==0);
+    CHECK(hexagonfs_close(fds,fd)==0);
+    fd=hexagonfs_openat(fds,rootfd,rootfd,"/persist/camera/Rear_third_camera_info.bin");
+    CHECK(fd>=0 && hexagonfs_close(fds,fd)==0);
+    CHECK(hexagonfs_openat(fds,rootfd,rootfd,"/mnt/vendor/persist/camera/Rear_third_camera_info.bin.extra")==-ENOENT);
+    CHECK(hexagonfs_openat(fds,rootfd,rootfd,"/mnt/vendor/persist/camera/another-camera.bin")==-ENOENT);
+    CHECK(hexagonfs_openat(fds,rootfd,rootfd,"/mnt/vendor/persist/camera/../../etc/passwd")==-ENOENT);
+    CHECK(stat(file,&stats)==0 && (stats.st_mode&0777)==0600 && stats.st_size==(off_t)sizeof(expected));
+    CHECK(hexagonfs_close(fds,rootfd)==0);
+    puts("PHONE_CAMERA_INFO_EXACT_BINARY_READ_ONLY_MAPPING_PASS");
+    return 0;
+}
