+    CHECK(pr_open(&fs,0,'w',&w)==0 && fs.files[0].size==0);
+    CHECK(pr_read(&fs,r,readbuf,2,&n,&eof)==0 && !n && eof);
+    CHECK(pr_seek(&fs,r,0,0)==0);
+    CHECK(pr_write(&fs,w,"abc",3,&n)==0 && n==3);
+    CHECK(pr_read(&fs,r,readbuf,8,&n,&eof)==0 && n==3 && eof && !memcmp(readbuf,"abc",3));
