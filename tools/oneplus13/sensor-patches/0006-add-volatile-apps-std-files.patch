+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Phone-only volatile file data. No host writable descriptor or pathname. */
+#ifndef PHONE_RAMFS_H
+#define PHONE_RAMFS_H
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#define PR_FILES 2u
+#define PR_FILE_CAP (1024u * 1024u)
+#define PR_IO_CAP (64u * 1024u)
+#define PR_HANDLES 16u
+#define PR_GEN_MAX 0x3fffffu
+_Static_assert(PR_HANDLES <= 256, "handle slot must fit in one byte");
+struct pr_file { unsigned char *data; size_t size, capacity; bool present; };
+struct pr_handle { uint32_t generation; size_t pos; unsigned int file; char mode; bool active; };
+struct phone_ramfs {
+    bool enabled;
+    struct pr_file files[PR_FILES];
+    struct pr_handle handles[PR_HANDLES];
+    void *(*resize)(void *,size_t); /* NULL = realloc; test can inject ENOMEM. */
+};
+static const char *const pr_names[PR_FILES]={
+    "/mnt/vendor/persist/sensors/registry/registry/DIR",
+    "/mnt/vendor/persist/sensors/cam_registry_dump.txt"};
+static inline int pr_index(const char *name)
+{
+    unsigned int i;
+    for(i=0;i<PR_FILES;i++) if(!strcmp(name,pr_names[i])) return (int)i;
+    return -1;
+}
+static inline bool pr_namespace(uint32_t handle) { return (handle & 0xc0000000u)==0x40000000u; }
+static inline struct pr_handle *pr_get(struct phone_ramfs *fs,uint32_t handle)
+{
+    unsigned int slot=handle&255u;
+    struct pr_handle *h;
+    if(!fs->enabled || !pr_namespace(handle) || slot>=PR_HANDLES) return NULL;
+    h=&fs->handles[slot];
+    if(!h->active || ((handle>>8)&PR_GEN_MAX)!=h->generation) return NULL;
+    return h;
+}
+static inline int pr_reserve(struct phone_ramfs *fs,struct pr_file *f,size_t size)
+{
+    void *next;
+    if(size>PR_FILE_CAP) return EFBIG;
+    if(size<=f->capacity) return 0;
+    next=fs->resize?fs->resize(f->data,size):realloc(f->data,size);
+    if(!next) return ENOMEM;
+    f->data=next;f->capacity=size;return 0;
+}
+static inline int pr_seed(struct phone_ramfs *fs,unsigned int index,const void *data,size_t size)
+{
+    int ret;
+    if(!fs->enabled || index>=PR_FILES || (size && !data)) return EINVAL;
+    if(fs->files[index].present) return EEXIST;
+    ret=pr_reserve(fs,&fs->files[index],size);if(ret) return ret;
+    if(size) memcpy(fs->files[index].data,data,size);
+    fs->files[index].size=size;fs->files[index].present=true;return 0;
+}
+static inline int pr_open(struct phone_ramfs *fs,unsigned int index,char mode,uint32_t *result)
+{
+    unsigned int i;
+    struct pr_handle *h;
+    struct pr_file *f;
+    if(!fs->enabled || index>=PR_FILES || !strchr("rwa",mode) || mode==0) return EINVAL;
+    for(i=0;i<PR_HANDLES;i++)
+        if(!fs->handles[i].active && fs->handles[i].generation<PR_GEN_MAX) break;
+    if(i==PR_HANDLES) return EMFILE;
+    f=&fs->files[index];
+    if(mode=='r' && !f->present) return ENOENT;
+    h=&fs->handles[i];h->generation++;h->active=true;h->file=index;h->mode=mode;
+    if(mode=='w') f->size=0;
+    f->present=true;h->pos=mode=='a'?f->size:0;
+    *result=0x40000000u|(h->generation<<8)|i;return 0;
+}
+static inline int pr_close(struct phone_ramfs *fs,uint32_t handle)
+{
+    struct pr_handle *h=pr_get(fs,handle);
+    if(!h) return EBADF;
+    h->active=false;h->pos=0;return 0;
+}
+static inline int pr_write(struct phone_ramfs *fs,uint32_t handle,const void *data,int32_t count,uint32_t *written)
+{
+    struct pr_handle *h=pr_get(fs,handle);
+    struct pr_file *f;
+    size_t pos,end;
+    int ret;
+    *written=0;
+    if(!h) return EBADF;
+    if(h->mode=='r') return EACCES;
+    if(count<0 || (uint32_t)count>PR_IO_CAP || (count && !data)) return EINVAL;
+    f=&fs->files[h->file];pos=h->mode=='a'?f->size:h->pos;
+    if(pos>f->size || (size_t)count>PR_FILE_CAP-pos) return EFBIG;
+    end=pos+(size_t)count;
+    ret=pr_reserve(fs,f,end);if(ret) return ret;
+    if(count) memmove(f->data+pos,data,(size_t)count);
+    h->pos=end;if(end>f->size) f->size=end;
+    *written=(uint32_t)count;return 0;
+}
+static inline int pr_read(struct phone_ramfs *fs,uint32_t handle,void *data,int32_t count,uint32_t *read_count,uint32_t *eof)
+{
+    struct pr_handle *h=pr_get(fs,handle);
+    struct pr_file *f;
+    size_t size;
+    *read_count=0;*eof=0;
+    if(!h) return EBADF;
+    if(h->mode!='r') return EACCES;
+    if(count<0 || (uint32_t)count>PR_IO_CAP || (count && !data)) return EINVAL;
+    f=&fs->files[h->file];
+    size=h->pos<f->size?f->size-h->pos:0;
+    if(size>(size_t)count) size=(size_t)count;
+    if(size) memcpy(data,f->data+h->pos,size);
+    h->pos+=size;*read_count=(uint32_t)size;*eof=size<(size_t)count;return 0;
+}
+static inline int pr_seek(struct phone_ramfs *fs,uint32_t handle,int32_t offset,uint32_t whence)
+{
+    struct pr_handle *h=pr_get(fs,handle);
+    int64_t base,pos;
+    if(!h) return EBADF;
+    if(whence>2) return EINVAL;
+    base=whence==0?0:whence==1?(int64_t)h->pos:(int64_t)fs->files[h->file].size;
+    pos=base+(int64_t)offset;
+    if(pos<0 || pos>(int64_t)fs->files[h->file].size) return EINVAL;
+    h->pos=(size_t)pos;return 0;
+}
+static inline void pr_destroy(struct phone_ramfs *fs)
+{
+    unsigned int i;
+    for(i=0;i<PR_FILES;i++) free(fs->files[i].data);
+    memset(fs,0,sizeof(*fs));
+}
+#endif
