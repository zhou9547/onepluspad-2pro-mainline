+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t count;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	uint32_t written;
+	int ret;
+
+	memset(outbufs[0].p, 0, outbufs[0].s);
+	if (inbufs[0].p == NULL || inbufs[0].s != sizeof(*first_in)
+	 || inbufs[1].s != first_in->count
+	 || outbufs[0].s != sizeof(*first_out))
+		return AEE_EBADPARM;
+	if (!pr_namespace(first_in->fd))
+		return AEE_EUNSUPPORTED;
+	if (first_in->count > PR_IO_CAP || first_in->count > INT32_MAX)
+		return AEE_EBADPARM;
+	ret = pr_write(&ctx->ramfs, first_in->fd, inbufs[1].p,
+		       first_in->count, &written);
+	if (ret)
+		return apps_std_ram_error(ret);
+	first_out->written = written;
+	first_out->is_eof = AEE_SUCCESS;
+	return AEE_SUCCESS;
 }
 
