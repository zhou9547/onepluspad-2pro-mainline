+static size_t encode_wire(unsigned char *wire, size_t capacity, size_t n,
+                          const void *const *bufs, const uint32_t *lens)
+{
+    size_t off=0,i;
+    uint32_t le;
+    for(i=0;i<n;i++) {
+        if(off+16+lens[i]>capacity) fail("wire buffer too small");
+        le=htole32(lens[i]);memcpy(&wire[off],&le,4);off+=4;
+        if(lens[i] && (off&7)) {
+            size_t pad=8-(off&7);
+            memset(&wire[off],0,pad);
+            off+=pad;
+        }
+        memcpy(&wire[off],bufs[i],lens[i]);off+=lens[i];
+    }
+    return off;
+}
