+    bufs[4]=mode;lens[4]=strlen(mode)+1;
+    result=invoke(OPEN_SC,5,bufs,lens,dispatch_ret,&returned);
+    if(result==AEE_SUCCESS && *dispatch_ret==0 && returned && returned[0].s==4)
+        memcpy(fd,returned[0].p,4);
+    else *fd=UINT32_MAX;
+    if(returned) iobuf_free(1,returned);
+    return result;
+}
+
+static uint32_t write_ram(uint32_t fd,const void *data,uint32_t count,
+                          uint32_t *written,uint32_t *eof,int *dispatch_ret)
+{
+    uint32_t primary[2]={htole32(fd),htole32(count)};
+    const void *bufs[2]={primary,data};
+    uint32_t lens[2]={sizeof(primary),count};
+    struct fastrpc_io_buffer *returned;
+    uint32_t out[2]={UINT32_MAX,UINT32_MAX};
+    uint32_t result=invoke(FWRITE_SC,2,bufs,lens,dispatch_ret,&returned);
+    if(*dispatch_ret==0 && returned && returned[0].s==sizeof(out))
+        memcpy(out,returned[0].p,sizeof(out));
+    *written=out[0];*eof=out[1];
+    if(returned) iobuf_free(1,returned);
+    return result;
+}
+
+static uint32_t read_ram(uint32_t fd,uint32_t count,unsigned char *data,
+                         uint32_t *read_count,uint32_t *eof,int *dispatch_ret)
+{
+    uint32_t primary[2]={htole32(fd),htole32(count)};
+    const void *bufs[1]={primary};uint32_t lens[1]={sizeof(primary)};
+    struct fastrpc_io_buffer *returned;
+    uint32_t out[2]={UINT32_MAX,UINT32_MAX};
+    uint32_t result=invoke(FREAD_SC,1,bufs,lens,dispatch_ret,&returned);
+    *read_count=0;*eof=UINT32_MAX;
+    if(*dispatch_ret==0 && returned) {
+        if(returned[0].s==sizeof(out)) memcpy(out,returned[0].p,sizeof(out));
+        if(returned[1].p && out[0]<=returned[1].s && out[0]<=count)
+            memcpy(data,returned[1].p,out[0]);
+        *read_count=out[0];*eof=out[1];
+        iobuf_free(2,returned);
+    }
+    return result;
+}
+
+static uint32_t simple_word(uint32_t sc,uint32_t fd,uint32_t extra,
+                            uint32_t words,int *dispatch_ret)
+{
+    uint32_t primary[3]={htole32(fd),htole32(extra),0};
+    const void *bufs[1]={primary};uint32_t lens[1]={words*4};
+    struct fastrpc_io_buffer *returned;
+    uint32_t result=invoke(sc,1,bufs,lens,dispatch_ret,&returned);
+    if(returned) iobuf_free(REMOTE_SCALARS_OUTBUFS(sc),returned);
+    return result;
+}
+
+static uint32_t fseek_word(uint32_t fd,uint32_t pos,uint32_t whence,
+                           int *dispatch_ret)
+{
+    uint32_t primary[3]={htole32(fd),htole32(pos),htole32(whence)};
+    const void *bufs[1]={primary};uint32_t lens[1]={sizeof(primary)};
+    struct fastrpc_io_buffer *returned;
+    uint32_t result=invoke(FSEEK_SC,1,bufs,lens,dispatch_ret,&returned);
+    if(returned) iobuf_free(0,returned);
+    return result;
+}
+
+static void make_source(const char *root)
+{
+    char path[4096],sensors[4096];
+    int fd;
+    if(snprintf(sensors,sizeof(sensors),"%s/sensors",root)>=(int)sizeof(sensors))
+        fail("path too long");
+    if(mkdir(sensors,0700) && errno!=EEXIST) fail("mkdir sensors");
+    if(snprintf(path,sizeof(path),"%s/registry",sensors)>=(int)sizeof(path) ||
+       (mkdir(path,0700) && errno!=EEXIST)) fail("mkdir registry");
+    if(snprintf(path,sizeof(path),"%s/registry/DIR",sensors)>=(int)sizeof(path))
+        fail("path too long");
+    fd=open(path,O_WRONLY|O_CREAT|O_TRUNC,0600);
+    if(fd<0 || write(fd,"source-data",11)!=11 || close(fd)) fail("write source DIR");
+}
+
+int main(int argc,char **argv)
+{
+    uint32_t fd=0,fd2=0,other=0,written=0,read=0,eof=0;
+    unsigned char buf[PR_IO_CAP];
+    int dispatch_ret;
+    const char *path0=pr_names[0];
+    const char *path1=pr_names[1];
+    static const char embedded[] = "/mnt/vendor/persist/sensors/cam_registry_dump.txt\0X";
+    unsigned char *large;
+    if(argc!=2) return 2;
+    if(mkdir(argv[1],0700) && access(argv[1],F_OK)) return 3;
+    make_source(argv[1]);
+    apps_std=fastrpc_apps_std_init_with_ramfs(construct_root_dir(argv[1],""));
+    if(!apps_std) fail("could not initialize RAM-enabled apps_std");
+
+    written=open_ram(path0,"r","ADSP_LIBRARY_PATH",";",strlen(path0)+1,&fd,&dispatch_ret);
+    if(written || dispatch_ret || !pr_namespace(fd)) {
+        fprintf(stderr,"seeded open result=%u dispatch=%d fd=%08x\n",written,dispatch_ret,fd);
+        fail("open seeded RAM file");
+    }
+    if(write_ram(fd,"x",1,&written,&eof,&dispatch_ret)!=AEE_EREADONLY ||
+       dispatch_ret || written || eof) fail("read handle refused write incorrectly");
+    written=fseek_word(fd,0,0,&dispatch_ret);
+    if(written || dispatch_ret) {
+        fprintf(stderr,"seek result=%u dispatch=%d fd=%08x\n",written,dispatch_ret,fd);
+        fail("seek read handle");
+    }
+    written=read_ram(fd,11,buf,&read,&eof,&dispatch_ret);
+    if(written || dispatch_ret || read!=11 || eof || memcmp(buf,"source-data",11)) {
+        fprintf(stderr,"seeded read result=%u dispatch=%d read=%u eof=%u data=%.*s\n",
+                written,dispatch_ret,read,eof,read<32?(int)read:32,buf);
+        fail("seeded readback");
+    }
+    if(simple_word(FCLOSE_SC,fd,0,1,&dispatch_ret) || dispatch_ret) fail("close read handle");
+
+    if(open_ram(path1,"w","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&other,&dispatch_ret)
+       || dispatch_ret) fail("open writable RAM file");
+    if(write_ram(other,"abcd",4,&written,&eof,&dispatch_ret) || dispatch_ret || written!=4 || eof)
+        fail("write RAM file");
+    if(open_ram(path1,"rb","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&fd,&dispatch_ret)
+       || dispatch_ret) fail("open second RAM handle");
+    if(read_ram(fd,4,buf,&read,&eof,&dispatch_ret) || dispatch_ret || read!=4 || eof ||
+       memcmp(buf,"abcd",4)) fail("cross-handle readback");
+    if(read_ram(fd,1,buf,&read,&eof,&dispatch_ret) || dispatch_ret || read || !eof)
+        fail("second handle independent EOF");
+    if(open_ram(path1,"ab","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&fd2,&dispatch_ret)
+       || dispatch_ret) fail("open append handle");
+    if(fseek_word(fd2,0,0,&dispatch_ret) || dispatch_ret) fail("seek append handle");
+    if(write_ram(fd2,"ef",2,&written,&eof,&dispatch_ret) || dispatch_ret || written!=2)
+        fail("append write");
+    if(simple_word(FFLUSH_SC,fd2,0,1,&dispatch_ret) || dispatch_ret) fail("flush RAM handle");
+    if(simple_word(FCLOSE_SC,fd2,0,1,&dispatch_ret) || dispatch_ret) fail("close append");
+    if(simple_word(FCLOSE_SC,fd,0,1,&dispatch_ret) || dispatch_ret) fail("close read");
+
+    if(open_ram(path1,"r","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&fd,&dispatch_ret)
+       || dispatch_ret || read_ram(fd,6,buf,&read,&eof,&dispatch_ret) || dispatch_ret ||
+       read!=6 || eof || memcmp(buf,"abcdef",6)) fail("append visible across handles");
+    if(simple_word(FCLOSE_SC,fd,0,1,&dispatch_ret) || dispatch_ret) fail("close final reader");
+
+    if(open_ram(path1,"r+","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&fd,&dispatch_ret)==0 ||
+       dispatch_ret || fd!=UINT32_MAX) fail("update mode not refused");
+    if(open_ram("/mnt/vendor/persist/sensors/cam_registry_dump.txt/","w",
+                "ADSP_LIBRARY_PATH",";",sizeof("/mnt/vendor/persist/sensors/cam_registry_dump.txt/"),
+                &fd,&dispatch_ret)==0 || dispatch_ret) fail("neighbor path not refused");
+    if(open_ram("x/../y","w","ADSP_LIBRARY_PATH",";",7,&fd,&dispatch_ret)==0 ||
+       dispatch_ret) fail("traversal path not refused");
+    if(open_ram(path1,"w","ADSP_LIBRARY_PATH",";",strlen(path1),&fd,&dispatch_ret)==0 ||
+       dispatch_ret) fail("unterminated path not refused");
+    if(open_ram(embedded,"w","ADSP_LIBRARY_PATH",";",sizeof(embedded)-1,&fd,&dispatch_ret)==0 ||
+       dispatch_ret) fail("embedded NUL path not refused");
+
+    large=malloc(PR_IO_CAP+1);if(!large) fail("large fixture");
+    memset(large,'Z',PR_IO_CAP+1);
+    if(open_ram(path1,"w","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&other,&dispatch_ret)
+       || dispatch_ret) fail("open cap fixture");
+    if(write_ram(other,"safe",4,&written,&eof,&dispatch_ret) || dispatch_ret || written!=4)
+        fail("pre-failure write");
+    if(write_ram(other,large,PR_IO_CAP+1,&written,&eof,&dispatch_ret)!=AEE_EBADPARM ||
+       dispatch_ret || written || eof) fail("oversize write not refused atomically");
+    if(open_ram(path1,"r","ADSP_LIBRARY_PATH",";",strlen(path1)+1,&fd,&dispatch_ret)
+       || dispatch_ret) fail("open preflight reader");
+    if(read_ram(fd,4,buf,&read,&eof,&dispatch_ret) || dispatch_ret || read!=4 ||
+       eof || memcmp(buf,"safe",4)) fail("failed write changed prior bytes");
+    written=read_ram(fd,PR_IO_CAP+1,buf,&read,&eof,&dispatch_ret);
+    if(written!=AEE_EBUFFERTOOSMALL || dispatch_ret!=1) {
+        fprintf(stderr,"oversize read result=%u dispatch=%d fd=%08x read=%u eof=%u\n",
+                written,dispatch_ret,fd,read,eof);
+        fail("oversize read not refused before allocation");
+    }
+    if(fseek_word(fd,0,3,&dispatch_ret)!=AEE_EBADPARM || dispatch_ret!=0)
+        fail("invalid whence indexed outside table");
+    if(simple_word(FCLOSE_SC,other,0,1,&dispatch_ret) || dispatch_ret) fail("close cap reader");
+    if(simple_word(FCLOSE_SC,fd,0,1,&dispatch_ret) || dispatch_ret) fail("close preflight reader");
+    if(simple_word(FREAD_SC,fd,1,2,&dispatch_ret)!=AEE_EBADHANDLE || dispatch_ret!=1)
+        fail("stale handle unexpectedly accepted");
+    free(large);
+
+    fastrpc_apps_std_deinit(apps_std);
+    puts("APPS_STD_RAM_WIRE_OPEN_READ_WRITE_SEEK_FLUSH_CLOSE_REJECT_CLEANUP_PASS");
+    return 0;
+}
