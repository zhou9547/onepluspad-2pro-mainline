+static uint32_t invoke(uint32_t sc, size_t n_in,
+                       const void *const *bufs, const uint32_t *lens,
+                       int *dispatch_ret, struct fastrpc_io_buffer **returned)
+{
+    struct fastrpc_interface *ifaces[]={NULL,apps_std};
+    struct fastrpc_decoder_context *ctx;
+    struct fastrpc_io_buffer *decoded;
+    unsigned char *wire=malloc(PR_IO_CAP+2048);
+    size_t wire_len;
+    uint32_t result=UINT32_MAX;
+    *returned=NULL;
+    if(!wire) fail("could not allocate wire fixture");
+    wire_len=encode_wire(wire,PR_IO_CAP+2048,n_in,bufs,lens);
+    ctx=inbuf_decode_start(sc);
+    if(!ctx || inbuf_decode(ctx,wire_len,wire) || !inbuf_decode_is_complete(ctx)) {
+        fprintf(stderr,"decode failed sc=%08x wire_len=%zu\n",sc,wire_len);
+        fail("could not decode wire request");
+    }
+    decoded=inbuf_decode_finish(ctx);
+    *dispatch_ret=fastrpc_invoke_requested_procedure(2,ifaces,1,sc,&result,decoded,returned);
+    iobuf_free(REMOTE_SCALARS_INBUFS(sc),decoded);
+    free(wire);
+    return result;
+}
