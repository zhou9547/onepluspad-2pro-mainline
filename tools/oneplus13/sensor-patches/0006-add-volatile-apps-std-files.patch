+static uint32_t apps_std_ram_error(int ret)
+{
+	if (ret == 0)
+		return AEE_SUCCESS;
+	switch (ret) {
+	case EBADF: return AEE_EBADHANDLE;
+	case EACCES: return AEE_EREADONLY;
+	case EINVAL: return AEE_EBADPARM;
+	case EMFILE: return AEE_EOUTOFHANDLES;
+	case ENOMEM: return AEE_ENOMEMORY;
+	case EFBIG: return AEE_EBUFFERTOOSMALL;
+	case ENOENT: return AEE_ENOSUCH;
+	default: return AEE_EFAILED;
+	}
+}
+
+static bool apps_std_strict_string(const struct fastrpc_io_buffer *buf)
+{
+	const char *value;
+
+	if (buf->p == NULL || buf->s == 0)
+		return false;
+	value = buf->p;
+	return value[buf->s - 1] == '\0'
+		&& memchr(value, '\0', buf->s - 1) == NULL;
+}
+
+static int apps_std_ram_mode(const char *mode, char *result)
+{
+	if (!strcmp(mode, "r") || !strcmp(mode, "rb"))
+		*result = 'r';
+	else if (!strcmp(mode, "w") || !strcmp(mode, "wb"))
+		*result = 'w';
+	else if (!strcmp(mode, "a") || !strcmp(mode, "ab"))
+		*result = 'a';
+	else
+		return -EINVAL;
+	return 0;
+}
+
+static int apps_std_seed_ram(struct apps_std_ctx *ctx, unsigned int index,
+			     const char *name, int dirfd)
+{
+	struct pr_file *file = &ctx->ramfs.files[index];
+	struct stat stats;
+	ssize_t got;
+	size_t done = 0;
+	int fd, ret;
+
+	if (file->present)
+		return 0;
+	fd = hexagonfs_openat(ctx->fds, ctx->rootfd, dirfd, name);
+	if (fd < 0)
+		return fd;
+	ret = hexagonfs_fstat(ctx->fds, fd, &stats);
+	if (ret)
+		goto out_close;
+	if (stats.st_size < 0 || (uint64_t) stats.st_size > PR_FILE_CAP) {
+		ret = -EFBIG;
+		goto out_close;
+	}
+	ret = pr_reserve(&ctx->ramfs, file, (size_t) stats.st_size);
+	if (ret)
+		goto out_close;
+	while (done < (size_t) stats.st_size) {
+		got = hexagonfs_read(ctx->fds, fd,
+				     (size_t) stats.st_size - done,
+				     file->data + done);
+		if (got <= 0) {
+			ret = got == 0 ? -EIO : (int) got;
+			goto out_close;
+		}
+		done += (size_t) got;
+	}
+	file->size = done;
+	file->present = true;
+	ret = 0;
+out_close:
+	hexagonfs_close(ctx->fds, fd);
+	return ret;
+}
+
+static uint32_t apps_std_ram_preflight(void *data,
+				      const struct fastrpc_io_buffer *inbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	uint32_t fd, count;
+
+	if (inbufs[0].p == NULL || inbufs[0].s != 2 * sizeof(uint32_t))
+		return AEE_EBADPARM;
+	memcpy(&fd, inbufs[0].p, sizeof(fd));
+	if (!pr_namespace(fd))
+		return AEE_SUCCESS;
+	memcpy(&count, (const char *) inbufs[0].p + sizeof(fd), sizeof(count));
+	if (pr_get(&ctx->ramfs, fd) == NULL)
+		return AEE_EBADHANDLE;
+	if (count > PR_IO_CAP)
+		return AEE_EBUFFERTOOSMALL;
+	return AEE_SUCCESS;
+}
 
