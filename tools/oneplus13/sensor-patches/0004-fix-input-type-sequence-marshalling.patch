-	uint8_t n_inbufs;
-	uint8_t n_outbufs;
+	size_t n_inbufs;
+	size_t n_outbufs;
 	uint32_t n_prim_in;
 	uint32_t n_prim_out;
 };
@@ -194,6 +194,8 @@
