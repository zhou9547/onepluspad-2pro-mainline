From: Codex <codex@openai.com>
Subject: [PATCH] phone-rpc: expand bounded reverse inputs

Run74 showed that sensor registry servicing exceeded the listener's256-byte
stack request buffer and later requested two additional exact volatile paths.
Use a separately allocated64KiB request buffer for adsp_listener_next2. A
returned length above the supplied capacity remains a hard EMSGSIZE failure.

Add these exact default-off RAM-backed paths:

  /mnt/vendor/persist/sensors/registry/fstempfile
  /mnt/vendor/persist/sensors/registry/parsed_file_list.csv

They use the existing bounded storage semantics, handle namespace and cleanup.
No neighboring path, persistent write, executable payload or sensor stream is
admitted. The listener refusal test now sends a300-byte request to exercise the
former cutoff instead of merely checking the constant.

--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -19,16 +19,20 @@
  * along with this program.  If not, see <https://www.gnu.org/licenses/>.
  */
 
+#include <errno.h>
 #include <inttypes.h>
 #include <libhexagonrpc/error.h>
 #include <libhexagonrpc/hexagonrpc.h>
 #include <stddef.h>
 #include <stdint.h>
 #include <stdio.h>
+#include <stdlib.h>
 
 #include "interface/adsp_listener.h"
 #include "iobuffer.h"
 #include "listener.h"
+
+#define FASTRPC_MAX_INPUT_BYTES (64u * 1024u)
 
 static int count_sizes_in_type4(const struct hrpc_inner_type_def_interp4 *type,
 				const struct fastrpc_io_buffer **curr_inbuf,
@@ -422,10 +426,10 @@
 				  uint32_t *handle,
 				  uint32_t *sc,
 				  const struct fastrpc_io_buffer *returned,
-				  struct fastrpc_io_buffer **decoded)
+				  struct fastrpc_io_buffer **decoded,
+				  uint32_t inbufs_size, char *inbufs)
 {
 	struct fastrpc_decoder_context *ctx;
-	char inbufs[256];
 	char *outbufs = NULL;
 	uint32_t inbufs_len;
 	uint32_t outbufs_len;
@@ -452,7 +456,7 @@
 				  *rctx, result,
 				  outbufs_len, outbufs,
 				  rctx, handle, sc,
-				  &inbufs_len, 256, inbufs);
+				  &inbufs_len, inbufs_size, inbufs);
 	if (ret) {
 		if (ret == -1)
 			perror("Could not fetch next FastRPC message");
@@ -462,9 +466,9 @@
 		goto err_free_outbufs;
 	}
 
-	if (inbufs_len > 256) {
-		fprintf(stderr, "Large (>256B) input buffers aren't implemented\n");
-		ret = -1;
+	if (inbufs_len > inbufs_size) {
+		fprintf(stderr, "Input buffers exceed the 64KiB listener limit\n");
+		ret = -EMSGSIZE;
 		goto err_free_outbufs;
 	}
 
@@ -584,6 +588,7 @@
 {
 	struct fastrpc_io_buffer *decoded = NULL,
 				 *returned = NULL;
+	char *inbufs;
 	uint32_t result = 0xffffffff;
 	uint32_t handle;
 	uint32_t rctx = 0;
@@ -596,11 +601,15 @@
 		fprintf(stderr, "Could not initialize the listener: %u\n", ret);
 		return ret;
 	}
+	inbufs = malloc(FASTRPC_MAX_INPUT_BYTES);
+	if (inbufs == NULL)
+		return -ENOMEM;
 
 	while (!ret) {
 		ret = return_for_next_invoke(fd,
 					     result, &rctx, &handle, &sc,
-					     returned, &decoded);
+					     returned, &decoded,
+					     FASTRPC_MAX_INPUT_BYTES, inbufs);
 		if (ret)
 			break;
 
@@ -630,5 +639,6 @@
 		n_outbufs = REMOTE_SCALARS_OUTBUFS(sc);
 	}
 
+	free(inbufs);
 	return ret;
 }
