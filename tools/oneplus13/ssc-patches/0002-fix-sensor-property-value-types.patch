@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Compiled with the actual sensor implementation, without QMI or streams. */
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    SSCSensor *sensor = g_object_new(SSC_TYPE_SENSOR, NULL);
+    SSCSensorPrivate *priv = ssc_sensor_get_instance_private(sensor);
+    GObjectClass *klass = G_OBJECT_GET_CLASS(sensor);
+    g_assert_cmpuint(G_PARAM_SPEC_VALUE_TYPE(g_object_class_find_property(klass, SSC_SENSOR_AVAILABLE)), ==, G_TYPE_BOOLEAN);
+    g_assert_cmpuint(G_PARAM_SPEC_VALUE_TYPE(g_object_class_find_property(klass, SSC_SENSOR_STREAM_TYPE)), ==, G_TYPE_UINT);
+    g_assert_cmpuint(G_PARAM_SPEC_VALUE_TYPE(g_object_class_find_property(klass, SSC_SENSOR_SAMPLE_RATE)), ==, G_TYPE_FLOAT);
+    struct { guint32 before; gboolean available; guint32 after; } value = {0x12345678, TRUE, 0x87654321};
+    g_object_get(sensor, SSC_SENSOR_AVAILABLE, &value.available, NULL);
+    g_assert_false(value.available);
+    priv->available = TRUE;
+    priv->stream_type = 1;
+    priv->sample_rate = 25.0f;
+    guint stream_type = 99;
+    gfloat sample_rate = -1;
+    g_object_get(sensor, SSC_SENSOR_AVAILABLE, &value.available,
+                 SSC_SENSOR_STREAM_TYPE, &stream_type,
+                 SSC_SENSOR_SAMPLE_RATE, &sample_rate, NULL);
+    g_assert_true(value.available);
+    g_assert_cmpuint(value.before, ==, 0x12345678);
+    g_assert_cmpuint(value.after, ==, 0x87654321);
+    g_assert_cmpuint(stream_type, ==, 1);
+    g_assert_cmpfloat(sample_rate, ==, 25.0f);
+    priv->available = FALSE;
+    g_object_get(sensor, SSC_SENSOR_AVAILABLE, &value.available, NULL);
+    g_assert_false(value.available);
+    g_object_unref(sensor);
+    g_print("PHONE_SENSOR_TYPED_PROPERTIES_NO_QRTR_PASS\n");
+    return 0;
+}
