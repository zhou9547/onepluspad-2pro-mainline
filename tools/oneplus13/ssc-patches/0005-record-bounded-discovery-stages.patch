--- a/tests/phone-sensor-properties.inc
+++ b/tests/phone-sensor-properties.inc
@@ -33,9 +33,44 @@
     g_array_unref(bytes);g_object_unref(sensor);
 }
 
+
+/* Feed a real protobuf event into the actual receive callback. No QMI client
+ * exists: removing the bound wrongly proceeds into an attribute send and fails.
+ */
+static void reject_oversized_uid_response(void)
+{
+    SSCSensor *sensor = g_object_new(SSC_TYPE_SENSOR, NULL);
+    SSCClient *client = g_object_new(SSC_TYPE_CLIENT, NULL);
+    SSCSensorPrivate *priv = ssc_sensor_get_instance_private(sensor);
+    priv->data_type=g_strdup("ambient_light");priv->service_available=TRUE;
+    ReportReceivedContext *ctx=g_slice_new0(ReportReceivedContext);
+    ctx->sensor=sensor;ctx->task=g_task_new(sensor,NULL,NULL,NULL);
+    GTask *task=g_object_ref(ctx->task);
+    priv->report_id=g_signal_connect(client,"report",G_CALLBACK(report_received),ctx);
+    SscUid ids[17];SscUid *pointers[17];
+    for(guint i=0;i<17;i++) {
+        ssc_uid__init(&ids[i]);ids[i].high=i+1;ids[i].low=i+2;pointers[i]=&ids[i];
+    }
+    SscSuidResponse response=SSC_SUID_RESPONSE__INIT;
+    response.data_type="ambient_light";response.n_uid=17;response.uid=pointers;
+    GArray *bytes=g_array_new(FALSE,FALSE,1);
+    g_array_set_size(bytes,ssc_suid_response__get_packed_size(&response));
+    ssc_suid_response__pack(&response,(guint8*)bytes->data);
+    report_received(client,SSC_MSG_RESPONSE_SUID,SSC_SENSOR_UID_SUID_HIGH,
+                    SSC_SENSOR_UID_SUID_LOW,bytes,ctx);
+    GError *error=NULL;
+    g_assert_false(g_task_propagate_boolean(task,&error));
+    g_assert_error(error,G_IO_ERROR,G_IO_ERROR_INVALID_DATA);
+    g_assert_cmpuint(priv->light_uid_count,==,0);
+    g_assert_cmpuint(priv->report_id,==,0);
+    g_clear_error(&error);g_array_unref(bytes);g_object_unref(task);
+    g_object_unref(client);g_object_unref(sensor);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
+    reject_oversized_uid_response();
     SSCSensor *sensor = g_object_new(SSC_TYPE_SENSOR, NULL);
     SSCSensorPrivate *priv = ssc_sensor_get_instance_private(sensor);
     GObjectClass *klass = G_OBJECT_GET_CLASS(sensor);
