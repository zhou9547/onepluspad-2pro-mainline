From: Codex <codex@openai.com>
Subject: [PATCH] phone: separate bounded three-vector sample diagnostic

Preserve the one-way metadata-only process. A separately linked executable
enrolls at most three discovered UIDs, enables each once at5Hz, collects3s
and disables each once. The original send path enforces the finite rate,
unknown-field, UID, message and repeat constraints before QMI. No service
integration, IIO publisher, physical axis or calibration claim is added.

--- a/src/libssc-phone-probe.c
+++ b/src/libssc-phone-probe.c
@@ -35,7 +35,12 @@
     }
     return accepted;
 }
+#include "phone-sample-policy.inc"
 gboolean ssc_phone_request_allowed(guint64 high,guint64 low,guint32 id,const GArray *payload)
 {
+    if(sample_mode) return phone_sample_request_allowed(high,low,id,payload);
     return !ssc_phone_metadata_only_locked() || ssc_phone_metadata_policy(high,low,id,payload);
 }
