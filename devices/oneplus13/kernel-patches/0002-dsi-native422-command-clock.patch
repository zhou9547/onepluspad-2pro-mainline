+/*
+ * A command-mode panel can advertise a characterized HS ceiling independent of
+ * its scan timings. Use the ceiling to finish each native422 burst promptly;
+ * CMD porches describe historical overhead, not the physical lane clock.
+ * Do not change the established video/C-PHY/bonded or unspecified-rate paths.
+ */
+static bool dsi_use_native422_hs_rate(const struct msm_dsi_host *msm_host,
+				    bool is_bonded_dsi)
+{
+	return msm_host->hs_rate && msm_host->dsc && msm_host->dsc->native_422 &&
+		!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) &&
+		!msm_host->cphy_mode && !is_bonded_dsi;
+}
+
+static int dsi_native422_cmd_rates(const struct msm_dsi_host *msm_host,
+				 const struct drm_display_mode *mode,
+				 unsigned long *pixel_rate,
+				 unsigned long *byte_rate)
+{
+	const struct drm_dsc_config *dsc = msm_host->dsc;
+	u32 bpp = mipi_dsi_pixel_format_to_bpp(msm_host->format);
+	u32 slices_per_pkt = msm_host->dsc_slice_per_pkt ?: 1;
+	u64 line_bytes, frame_bits, refresh_hz, required_lane_rate;
+
+	if (!msm_host->lanes || msm_host->lanes > 4 || bpp != 30 ||
+	    mode->clock <= 0 || mode->hdisplay <= 0 || mode->vdisplay <= 0 ||
+	    mode->htotal < mode->hdisplay || mode->vtotal < mode->vdisplay ||
+	    !dsc->slice_width || !dsc->slice_chunk_size || !dsc->slice_count ||
+	    dsc->pic_width != mode->hdisplay || dsc->pic_height != mode->vdisplay ||
+	    dsc->slice_count * dsc->slice_width != dsc->pic_width ||
+	    slices_per_pkt > dsc->slice_count ||
+	    dsc->slice_count % slices_per_pkt)
+		return -EINVAL;
+
+	/* Round down to a whole byte clock, never exceed the advertised ceiling. */
+	*byte_rate = msm_host->hs_rate / 8;
+	if (!*byte_rate)
+		return -EINVAL;
+
+	/* Each packet has a four-byte header, a DCS opcode and a two-byte CRC. */
+	line_bytes = (u64)dsc->slice_count * dsc->slice_chunk_size +
+		     7 * (dsc->slice_count / slices_per_pkt);
+	frame_bits = line_bytes * mode->vdisplay * 8;
+	/* Round refresh upward: a conservative payload lower-bound check. */
+	refresh_hz = DIV_ROUND_UP_ULL((u64)mode->clock * 1000,
+				    (u64)mode->htotal * mode->vtotal);
+	required_lane_rate = DIV_ROUND_UP_ULL(frame_bits * refresh_hz,
+					    msm_host->lanes);
+	if (required_lane_rate > (u64)*byte_rate * 8)
+		return -ERANGE;
+
+	/* Retain MSM's uncompressed interface-bpp convention for the pixel clock. */
+	*pixel_rate = mult_frac(*byte_rate, 8 * msm_host->lanes, bpp);
+	return 0;
+}
