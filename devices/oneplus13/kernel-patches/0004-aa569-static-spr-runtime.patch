+bool dpu_encoder_spr_quiescent(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(drm_enc);
+
+	if (READ_ONCE(enc->frame_busy_mask[0]) ||
+	    atomic_read(&enc->frame_done_timeout_cnt))
+		return false;
+	return !READ_ONCE(enc->enabled) ||
+		(enc->disp_info.intf_type == INTF_DSI && enc->disp_info.is_cmd_mode);
+}
+
+bool dpu_encoder_aa569_format(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(drm_enc);
+	struct drm_dsc_config *dsc;
+
+	if (enc->disp_info.intf_type != INTF_DSI || !enc->disp_info.is_cmd_mode ||
+	    enc->disp_info.num_of_h_tiles != 1 || enc->disp_info.h_tile_instance[0] != 0)
+		return false;
+	dsc = dpu_encoder_get_dsc_config(drm_enc);
+	return dsc && dsc->native_422 && !dsc->native_420 && !dsc->convert_rgb &&
+		dsc->dsc_version_major == 1 && dsc->dsc_version_minor == 2 &&
+		dsc->bits_per_component == 10 && dsc->bits_per_pixel == 128 &&
+		dsc->pic_width == 1440 && dsc->pic_height == 3168 &&
+		dsc->slice_width == 720 && dsc->slice_height == 22;
+}
