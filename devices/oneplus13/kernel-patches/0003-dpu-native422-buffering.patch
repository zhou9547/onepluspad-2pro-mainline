+	for (i = 0; i < MAX_CHANNELS_PER_ENC; i++)
+		if (dpu_enc->hw_pp[i] && dpu_enc->hw_pp[i]->ops.setup_ppb_fifo_size)
+			dpu_enc->hw_pp[i]->ops.setup_ppb_fifo_size(dpu_enc->hw_pp[i], pixels);
+}
