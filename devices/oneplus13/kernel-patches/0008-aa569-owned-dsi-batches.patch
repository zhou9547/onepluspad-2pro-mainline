diff --git a/drivers/gpu/drm/drm_mipi_dsi.c b/drivers/gpu/drm/drm_mipi_dsi.c
--- a/drivers/gpu/drm/drm_mipi_dsi.c
+++ b/drivers/gpu/drm/drm_mipi_dsi.c
@@ -584,6 +584,38 @@
 EXPORT_SYMBOL(mipi_dsi_create_packet);
 
 /**
+ * mipi_dsi_transfer_batch - synchronously transmit one command group
+ * @dsi: attached peripheral
+ * @msgs: complete group, with explicit channel and transmission flags
+ * @count: number of messages
+ *
+ * The host owns the entire group until completion or error. All buffers must
+ * remain valid until return. Device mode_flags are not applied to these explicit
+ * messages. No serial fallback is provided: separate kickoffs change timing.
+ * Hosts must reject unsupported groups before sending any packet. An error
+ * after kickoff may mean the panel received part or all of the group; this
+ * interface provides no rollback of peripheral state and must not be retried
+ * automatically. No queued commands may survive return.
+ *
+ * Return: 0 on completion, negative errno on failure; -EOPNOTSUPP if absent.
+ */
+int mipi_dsi_transfer_batch(struct mipi_dsi_device *dsi,
+			    const struct mipi_dsi_msg *msgs, size_t count)
+{
+	size_t i;
+
+	if (!dsi || !dsi->attached || !dsi->host || !msgs || !count)
+		return -EINVAL;
+	for (i = 0; i < count; i++)
+		if (msgs[i].channel != dsi->channel)
+			return -EINVAL;
+	if (!dsi->host->ops || !dsi->host->ops->transfer_batch)
+		return -EOPNOTSUPP;
+	return dsi->host->ops->transfer_batch(dsi->host, msgs, count);
+}
+EXPORT_SYMBOL_GPL(mipi_dsi_transfer_batch);
+
