+/* Validate the entire bounded group before touching DMA memory or resources. */
+static int dsi_batch_size(struct msm_dsi_host *msm_host,
+			  const struct mipi_dsi_msg *msgs, size_t count)
+{
+	size_t i, total = 0;
+	struct mipi_dsi_packet packet;
+	int ret;
+
+	if (!msgs || !count || count > 64 || msm_host->tx_size <= 0)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		const struct mipi_dsi_msg *msg = &msgs[i];
+		size_t len;
+
+		/* Only the characterized AA569 DCS writes; no ACK/read/mixed LP. */
+		if (!msg->tx_buf || !msg->tx_len || msg->tx_len > 100 ||
+		    msg->rx_buf || msg->rx_len || msg->channel != 0 ||
+		    (msg->flags & ~MIPI_DSI_MSG_USE_LPM) ||
+		    msg->flags != msgs[0].flags ||
+		    msg->type != (msg->tx_len == 1 ? MIPI_DSI_DCS_SHORT_WRITE :
+				  msg->tx_len == 2 ? MIPI_DSI_DCS_SHORT_WRITE_PARAM :
+						     MIPI_DSI_DCS_LONG_WRITE))
+			return -EINVAL;
+		ret = mipi_dsi_create_packet(&packet, msg);
+		if (ret)
+			return ret;
+		len = ALIGN(packet.size, 4);
+		if (len > msm_host->tx_size - total)
+			return -EMSGSIZE;
+		total += len;
+	}
+	return total;
+}
+
+static int dsi_batch_pack(struct msm_dsi_host *msm_host,
+			  const struct mipi_dsi_msg *msgs, size_t count)
+{
+	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
+	struct mipi_dsi_packet packet;
+	size_t i, offset = 0, len;
+	u8 *data;
+	int ret;
+
+	ret = dsi_batch_size(msm_host, msgs, count);
+	if (ret < 0)
+		return ret;
+	data = cfg_hnd->ops->tx_buf_get(msm_host);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	for (i = 0; i < count; i++) {
+		ret = mipi_dsi_create_packet(&packet, &msgs[i]);
+		if (ret)
+			goto out;
+		len = ALIGN(packet.size, 4);
+		data[offset] = packet.header[1];
+		data[offset + 1] = packet.header[2];
+		data[offset + 2] = packet.header[0];
+		data[offset + 3] = i == count - 1 ? BIT(7) : 0;
+		if (mipi_dsi_packet_format_is_long(msgs[i].type))
+			data[offset + 3] |= BIT(6);
+		if (packet.payload_length)
+			memcpy(data + offset + 4, packet.payload, packet.payload_length);
+		memset(data + offset + packet.size, 0xff, len - packet.size);
+		offset += len;
+	}
+	ret = offset;
+out:
+	if (cfg_hnd->ops->tx_buf_put)
+		cfg_hnd->ops->tx_buf_put(msm_host);
+	return ret;
+}
+
+static int dsi_batch_prepare(struct msm_dsi_host *msm_host,
+			     const struct mipi_dsi_msg *msg)
+{
+	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
+	int ret;
+
+	/* The legacy single-message path is unchanged. Check every acquisition. */
+	ret = pm_runtime_resume_and_get(&msm_host->pdev->dev);
+	if (ret < 0)
+		return ret;
+	ret = cfg_hnd->ops->link_clk_set_rate(msm_host);
+	if (ret)
+		goto put_pm;
+	ret = cfg_hnd->ops->link_clk_enable(msm_host);
+	if (ret)
+		goto put_pm; /* link_clk_enable unwinds its own partial enables */
+	if (!(msg->flags & MIPI_DSI_MSG_USE_LPM))
+		dsi_set_tx_power_mode(0, msm_host);
+	msm_host->dma_cmd_ctrl_restore = dsi_read(msm_host, REG_DSI_CTRL);
+	dsi_write(msm_host, REG_DSI_CTRL, msm_host->dma_cmd_ctrl_restore |
+		  DSI_CTRL_CMD_MODE_EN | DSI_CTRL_ENABLE);
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_DMA_DONE, 1);
+	return 0;
+put_pm:
+	/* set_rate may have voted OPP before a later parent/rate/enable failed. */
+	dev_pm_opp_set_rate(&msm_host->pdev->dev, 0);
+	pm_runtime_put(&msm_host->pdev->dev);
+	return ret;
+}
+
+static int dsi_host_transfer_batch(struct mipi_dsi_host *host,
+				   const struct mipi_dsi_msg *msgs, size_t count)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	int ret, len;
+
+	mutex_lock(&msm_host->cmd_mutex);
+	if (!msm_host->aa569_batch || !msm_host->power_on ||
+	    msm_host->cphy_mode || (msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) ||
+	    !msm_dsi_manager_batch_allowed(msm_host->id)) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	len = dsi_batch_pack(msm_host, msgs, count);
+	if (len < 0) {
+		ret = len;
+		goto unlock;
+	}
+	ret = dsi_batch_prepare(msm_host, &msgs[0]);
+	if (ret)
+		goto unlock;
+	ret = dsi_cmd_dma_tx(msm_host, len);
+	if (ret == -ETIMEDOUT || (ret >= 0 && ret != len))
+		dsi_sw_reset(msm_host); /* abort DMA before releasing/reusing buffer */
+	/* Always restore resources, including timeout/IOVA/short DMA failures. */
+	msm_dsi_host_xfer_restore(host, &msgs[0]);
+	if (ret >= 0)
+		ret = ret == len ? 0 : -EIO;
+unlock:
+	mutex_unlock(&msm_host->cmd_mutex);
 	return ret;
 }
 
@@ -1867,6 +2012,7 @@
 	.attach = dsi_host_attach,
 	.detach = dsi_host_detach,
 	.transfer = dsi_host_transfer,
+	.transfer_batch = dsi_host_transfer_batch,
 };
 
