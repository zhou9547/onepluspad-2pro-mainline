+/* Called only by the isolated AA569 atomic budget, after SSPP assignment.
+ * Recompute from the NEW pipe geometry; atomic_update's cached plane votes
+ * still describe the previous frame during the check of a fresh enable.
+ */
+int dpu_plane_calc_aa569_perf(struct drm_plane_state *state,
+			    const struct drm_display_mode *mode, u64 *bw, u64 *clock)
+{
+	struct dpu_plane *pdpu = to_dpu_plane(state->plane);
+	struct dpu_plane_state *pstate = to_dpu_plane_state(state);
+	const struct msm_format *fmt;
+	u64 total = 0, maximum = 0;
+	int i;
+
+	if (!state->fb || !state->visible)
+		return -EINVAL;
+	fmt = msm_framebuffer_format(state->fb);
+	for (i = 0; i < PIPES_PER_PLANE; i++) {
+		struct dpu_sw_pipe_cfg *cfg = &pstate->pipe_cfg[i];
+
+		if (!drm_rect_width(&cfg->src_rect))
+			continue;
+		if (drm_rect_width(&cfg->src_rect) < 0 ||
+		    drm_rect_height(&cfg->src_rect) <= 0 ||
+		    drm_rect_width(&cfg->dst_rect) <= 0 ||
+		    drm_rect_height(&cfg->dst_rect) <= 0)
+			return -EINVAL;
+		total += _dpu_plane_calc_bw(pdpu->catalog, fmt, mode, cfg);
+		maximum = max(maximum, _dpu_plane_calc_clk(mode, cfg));
+	}
+	if (!total || !maximum)
+		return -EINVAL;
+	*bw = total;
+	*clock = maximum;
+	return 0;
 }
 
