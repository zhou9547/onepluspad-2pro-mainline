+static int dpu_aa569_spr_calc(struct drm_crtc_state *state,
+			    const struct dpu_perf_cfg *cfg,
+			    struct dpu_core_perf_params *perf)
+{
+	const struct drm_display_mode *mode = &state->adjusted_mode;
+	struct dpu_core_perf_params next = { .max_per_pipe_ib = cfg->min_dram_ib };
+	struct drm_plane *plane;
+	struct drm_plane_state *pstate;
+	u64 bw, clock, product;
+	u32 remainder;
+	int ret;
+
+	next.core_clk_rate = (u64)mode->vtotal * mode->hdisplay * drm_mode_vrefresh(mode);
+	drm_atomic_crtc_state_for_each_plane_state(plane, pstate, state) {
+		if (!pstate->visible)
+			continue;
+		ret = dpu_plane_calc_aa569_perf(pstate, mode, &bw, &clock);
+		if (ret)
+			return ret;
+		if (check_add_overflow(next.bw_ctl, bw, &next.bw_ctl))
+			return -EOVERFLOW;
+		next.core_clk_rate = max(next.core_clk_rate, clock);
+	}
+	if (cfg->bw_inefficiency_factor) {
+		if (check_mul_overflow(next.bw_ctl, cfg->bw_inefficiency_factor, &product))
+			return -EOVERFLOW;
+		next.bw_ctl = div_u64_rem(product, 100, &remainder);
+		next.bw_ctl += remainder != 0;
+	}
+	if (cfg->clk_inefficiency_factor) {
+		if (check_mul_overflow(next.core_clk_rate, cfg->clk_inefficiency_factor, &product))
+			return -EOVERFLOW;
+		next.core_clk_rate = div_u64_rem(product, 100, &remainder);
+		next.core_clk_rate += remainder != 0;
+	}
+	*perf = next;
 	return 0;
 }
 
