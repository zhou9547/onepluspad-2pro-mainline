+}
+
+static struct device_attribute dev_attr_oneplus13_otg_vbus_enable =
+	__ATTR(oneplus13_otg_vbus_enable, 0400, oneplus13_otg_vbus_enable_show, NULL);
+static struct device_attribute dev_attr_oneplus13_otg_boost_current =
