+
 static struct attribute *op13_otg_attrs[] = {
 	&dev_attr_oneplus13_otg_ap_enable.attr,
 	&dev_attr_oneplus13_otg_switch.attr,
 	&dev_attr_oneplus13_otg_lease.attr,
+	&dev_attr_oneplus13_otg_vbus_enable.attr,
+	&dev_attr_oneplus13_otg_boost_current.attr,
 	NULL,
 };
 
 static umode_t op13_otg_visible(struct kobject *kobj, struct attribute *attr, int n)
 {
 	if (!op13_otg_machine())
+		return 0;
+	if (!oneplus13_otg_supply_read &&
+	    (attr == &dev_attr_oneplus13_otg_vbus_enable.attr ||
+	     attr == &dev_attr_oneplus13_otg_boost_current.attr))
 		return 0;
 	if (attr == &dev_attr_oneplus13_otg_lease.attr &&
 	    !oneplus13_otg_lease_enabled)
 		return 0;
 	return attr->mode;
 }
 
 static const struct attribute_group op13_otg_group = {
 	.attrs = op13_otg_attrs,
 	.is_visible = op13_otg_visible,
 };
 
 static void qcom_battmgr_enable_worker(struct work_struct *work)
 {
 	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr, enable_work);
 	struct qcom_battmgr_enable_request req = {
 		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
 		.hdr.type = cpu_to_le32(PMIC_GLINK_NOTIFY),
 		.hdr.opcode = cpu_to_le32(BATTMGR_REQUEST_NOTIFICATION),
 	};
 	int ret;
 
 	mutex_lock(&battmgr->lock);
 	if (READ_ONCE(battmgr->op13_otg_stopping)) {
 		mutex_unlock(&battmgr->lock);
 		return;
 	}
 	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
 	mutex_unlock(&battmgr->lock);
 	if (ret)
 		dev_err(battmgr->dev, "failed to request power notifications\n");
 }
 
 static void qcom_battmgr_pdr_notify(void *priv, int state)
 {
 	struct qcom_battmgr *battmgr = priv;
 	unsigned long flags;
 
 	spin_lock_irqsave(&battmgr->op13_otg_lock, flags);
 	if (state == SERVREG_SERVICE_STATE_UP && !battmgr->op13_otg_stopping) {
 		WRITE_ONCE(battmgr->service_up, true);
 		schedule_work(&battmgr->enable_work);
 	} else {
 		/* Preserve initial DOWN, but never reuse optional tuples after loss. */
 		if (READ_ONCE(battmgr->service_up) ||
 		    READ_ONCE(battmgr->op13_otg_pending))
 			WRITE_ONCE(battmgr->op13_otg_poisoned, true);
 		WRITE_ONCE(battmgr->service_up, false);
 	}
 	spin_unlock_irqrestore(&battmgr->op13_otg_lock, flags);
 }
 
