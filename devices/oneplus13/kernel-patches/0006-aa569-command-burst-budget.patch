+/* Fixed AA569 command120Hz only. The stock MDP budget is6800us, not the
+ * full8333us frame interval: 1e6/(6800*120) ==125/102. Scale existing
+ * conservative plane/prefill votes with ceiling rounding. This is a resource
+ * budget, not a hardware timer or an exact replica of proprietary HAL votes.
+ */
+static int dpu_aa569_spr_scale(u64 input, u64 *output)
+{
+	u64 product;
+	u32 remainder;
+
+	if (check_mul_overflow(input, 125ULL, &product))
+		return -EOVERFLOW;
+	*output = div_u64_rem(product, 102, &remainder);
+	*output += remainder != 0;
+	return 0;
+}
+
+static int dpu_aa569_spr_budget(struct dpu_core_perf_params *perf, u64 max_clock)
+{
+	struct dpu_core_perf_params next = *perf;
+	u64 peak, minimum_peak;
+	u32 remainder;
+	int ret;
+
+	if (!max_clock)
+		return -EINVAL;
+	ret = dpu_aa569_spr_scale(perf->bw_ctl, &next.bw_ctl);
+	if (ret)
+		return ret;
+	ret = dpu_aa569_spr_scale(perf->core_clk_rate, &next.core_clk_rate);
+	if (ret)
+		return ret;
+	ret = dpu_aa569_spr_scale(perf->max_per_pipe_ib, &peak);
+	if (ret)
+		return ret;
+	/* Each path's peak covers even the aggregate average. Intentionally
+	 * conservative until physical bandwidth/frame completion is measured.
+	 */
+	minimum_peak = div_u64_rem(next.bw_ctl, 1000, &remainder);
+	minimum_peak += remainder != 0;
+	peak = max(peak, minimum_peak);
+	if (peak > U32_MAX || next.core_clk_rate > max_clock)
+		return -E2BIG;
+	next.max_per_pipe_ib = peak;
+	*perf = next;
+	return 0;
+}
