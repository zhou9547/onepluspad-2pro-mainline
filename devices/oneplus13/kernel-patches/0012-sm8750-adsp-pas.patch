From: OnePlus 13 mainline port
Subject: [PATCH] remoteproc: qcom: pas: Add SM8750 ADSP support

Add the SM8750 ADSP PAS resource descriptor and compatible string.
The ADSP on SM8750 is similar to X1E80100 but uses standard CX/MX
power domains. auto_boot is set to true so the remoteproc registers
and attempts firmware load (adsp.mdt). If the ADSP is already booted
by the hypervisor, the PAS subsystem handles the attach path.

Signed-off-by: OnePlus 13 mainline port
---
 drivers/remoteproc/qcom_q6v5_pas.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index aaaaaaaaaaaa..bbbbbbbbbbbb 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -XXX,6 +XXX,27 @@ static const struct qcom_pas_data sm8750_mpss_resource = {
 	.sysmon_name = "modem"
 };
 
+static const struct qcom_pas_data sm8750_adsp_resource = {
+	.crash_reason_smem = 423,
+	.firmware_name = "adsp.mdt",
+	.dtb_firmware_name = "adsp_dtb.mdt",
+	.pas_id = 1,
+	.dtb_pas_id = 0x24,
+	.minidump_id = 5,
+	.auto_boot = true,
+	.decrypt_shutdown = true,
+	.proxy_pd_names = (char*[]){
+		"cx",
+		NULL
+	},
+	.load_state = "adsp",
+	.ssr_name = "lpass",
+	.sysmon_name = "adsp",
+	.ssctl_id = 0x14,
+};
+
 static const struct of_device_id adsp_of_match[] = {
 	{ .compatible = "qcom,sm8750-mpss-pas", .data = &sm8750_mpss_resource },
+	{ .compatible = "qcom,sm8750-adsp-pas", .data = &sm8750_adsp_resource },
 	{ .compatible = "qcom,x1e80100-adsp-pas", .data = &x1e80100_adsp_resource },
 	{ }
 };
