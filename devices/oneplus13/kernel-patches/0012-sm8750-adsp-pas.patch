From: OnePlus 13 mainline port
Subject: [PATCH] remoteproc: qcom: pas: SM8750 ADSP via lcx/lmx domains

The previous sm8750-adsp-pas descriptor requested the "cx" proxy power
domain, but the SM8750 device tree names the ADSP domains "lcx" and "lmx".
dev_pm_domain_attach_by_name() then returns NULL and the probe fails with
-61 (ENODATA) before any PAS call is made - this was the real cause of the
earlier failure, not Gunyah. Match the reference erhai project (same SoC)
by mirroring the sm8550_adsp_resource fields: auto_boot=true with the
lcx/lmx proxy domains, loading adsp.mdt + adsp_dtb.mdt.

Signed-off-by: OnePlus 13 mainline port
---
--- a/drivers/remoteproc/qcom_q6v5_pas.c	2026-10-24 23:37:04.372131200 +0800
+++ b/drivers/remoteproc/qcom_q6v5_pas.c	2026-10-25 09:30:00.000000000 +0800
@@ -1571,6 +1571,24 @@
 	.region_assign_count = 2,
 	.region_assign_vmid = QCOM_SCM_VMID_MSS_MSA,
 };
+static const struct qcom_pas_data sm8750_adsp_resource = {
+	.crash_reason_smem = 423,
+	.firmware_name = "adsp.mdt",
+	.dtb_firmware_name = "adsp_dtb.mdt",
+	.pas_id = 1,
+	.dtb_pas_id = 0x24,
+	.minidump_id = 5,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"lcx",
+		"lmx",
+		NULL
+	},
+	.load_state = "adsp",
+	.ssr_name = "lpass",
+	.sysmon_name = "adsp",
+	.ssctl_id = 0x14,
+};

 static const struct of_device_id qcom_pas_of_match[] = {
 	{ .compatible = "qcom,eliza-adsp-pas", .data = &sm8550_adsp_resource },
@@ -1647,6 +1665,7 @@
 	{ .compatible = "qcom,sm8650-cdsp-pas", .data = &sm8650_cdsp_resource },
 	{ .compatible = "qcom,sm8650-mpss-pas", .data = &sm8650_mpss_resource },
 	{ .compatible = "qcom,sm8750-mpss-pas", .data = &sm8750_mpss_resource },
+{ .compatible = "qcom,sm8750-adsp-pas", .data = &sm8750_adsp_resource },
 	{ .compatible = "qcom,x1e80100-adsp-pas", .data = &x1e80100_adsp_resource },
 	{ .compatible = "qcom,x1e80100-cdsp-pas", .data = &x1e80100_cdsp_resource },
 	{ },
