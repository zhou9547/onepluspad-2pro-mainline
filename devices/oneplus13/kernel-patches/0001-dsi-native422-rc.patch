--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1893,6 +1893,9 @@
 	else
 		offset = 15;
 
+	if (dsc->native_422)
+		return min(offset, (u8)(3 * bpp * 4 - 3 * bpp));
+
 	return min(offset, (u8)((3 * bpp + 2) * 3 - 3 * bpp));
 }
 
@@ -1923,8 +1926,15 @@
 		return -EOPNOTSUPP;
 	}
 
+	/* Native 422 must retain its chroma mode and use the matching RC table. */
+	if (dsc->native_422 &&
+	    (dsc->dsc_version_major != 1 || dsc->dsc_version_minor != 2 ||
+	     dsc->native_420 || dsc->slice_width < 2 ||
+	     (dsc->slice_width & 1) || dsc->slice_height < 2))
+		return -EINVAL;
+
 	dsc->simple_422 = 0;
-	dsc->convert_rgb = 1;
+	dsc->convert_rgb = !dsc->native_422;
 	dsc->vbr_enable = 0;
 
 	drm_dsc_set_const_params(dsc);
@@ -1938,7 +1948,7 @@
 	 * slice-height dependent first_line_bpg_offset.
 	 */
 	if (dsc->dsc_version_major == 1 && dsc->dsc_version_minor >= 2)
-		rc_type = DRM_DSC_1_2_444;
+		rc_type = dsc->native_422 ? DRM_DSC_1_2_422 : DRM_DSC_1_2_444;
 	else
 		rc_type = DRM_DSC_1_1_PRE_SCR;
 
@@ -1948,11 +1958,29 @@
 		return ret;
 	}
 
-	if (rc_type == DRM_DSC_1_2_444)
+	if (rc_type == DRM_DSC_1_2_444 || rc_type == DRM_DSC_1_2_422)
 		dsc->first_line_bpg_offset = dsi_dsc_1_2_first_line_bpg_offset(dsc);
 
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
 	dsc->line_buf_depth = dsc->bits_per_component + 1;
+
+	if (dsc->native_422) {
+		struct drm_dsc_config group = *dsc;
+
+		/*
+		 * The DRM RC arithmetic consumes two-pixel-group bpp for native
+		 * 422. MSM bandwidth/timing and the DPU hardware API consume
+		 * physical-pixel bpp (the DPU doubles its own register field).
+		 * Do not leave the doubled value in the shared configuration.
+		 */
+		group.bits_per_pixel *= 2;
+		ret = drm_dsc_compute_rc_parameters(&group);
+		if (ret)
+			return ret;
+		group.bits_per_pixel = dsc->bits_per_pixel;
+		*dsc = group;
+		return 0;
+	}
 
 	return drm_dsc_compute_rc_parameters(dsc);
 }
