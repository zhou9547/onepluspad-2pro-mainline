[org.gnome.desktop.a11y.applications]
screen-keyboard-enabled=true

[org.gnome.desktop.interface]
toolkit-accessibility=true

# This is the bounded RAM validation profile. Automatic DPMS off currently
# leaves the physical panel black after wake; keep the display awake until
# the phone's blank/unblank path is qualified. Manual lock is unchanged.
[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.shell]
favorite-apps=['org.gnome.Epiphany.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-writer.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']

[org.gnome.shell:ubuntu]
favorite-apps=['org.gnome.Epiphany.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-writer.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']

[org.gnome.shell.extensions.dash-to-dock]
dock-fixed=true
autohide=false
intellihide=false
dock-position='LEFT'
extend-height=true
