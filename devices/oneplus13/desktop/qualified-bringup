#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Explicit previously-qualified features, only inside a protected RAM session.
set -euo pipefail
mode=${1:-}
case "$mode" in --wifi|--all) ;; *) echo 'Usage: qualified-bringup {--wifi|--all}'; exit 2 ;; esac
test -f /run/oneplus13/ram-session
grep -q ' / overlay ' /proc/mounts
systemctl is-active --quiet oneplus13-ram-guard.service
systemctl is-active --quiet oneplus13-ram-deadline.timer
for device in /sys/class/block/*; do
    case "${device##*/}" in ram*|zram*|loop*) continue;; esac
    test "$(cat "$device/ro")" = 1
done
test ! -e /run/oneplus13/qualified-bringup-attempted
touch /run/oneplus13/qualified-bringup-attempted
bindings=$(python3 - <<'PY'
import hashlib,json,os,pathlib,shlex
p=pathlib.Path('/usr/lib/oneplus13-desktop/runtime-bindings.private.json')
v=json.loads(p.read_text())
assert v['kernel_release']==os.uname().release
for n,h in v['firmware_sha256'].items():
    assert hashlib.sha256((pathlib.Path('/usr/lib/firmware')/n).read_bytes()).hexdigest()==h
print('PLATFORM_KERNEL_RELEASE='+shlex.quote(v['kernel_release']))
for k in ['CPUCP_MODULE_SHA256','SOCINFO_MODULE_SHA256','CEC_MODULE_SHA256','UBWC_MODULE_SHA256','MODULE_POLICY_SHA256']:
    print(k+'='+shlex.quote(v[k]))
PY
)
eval "$bindings"
export PLATFORM_KERNEL_RELEASE CPUCP_MODULE_SHA256 SOCINFO_MODULE_SHA256
timeout -k 1 28 bash /usr/libexec/oneplus13-ram-platform-prerequisites.sh
ADSP=''
for rp in /sys/class/remoteproc/remoteproc*; do
    case "$(cat "$rp/name")" in *adsp*) ADSP=$rp;; esac
done
test -n "$ADSP"
case "$(cat "$ADSP/state")" in
    offline) timeout -k 2 25 bash -c 'echo start > "$1/state"' _ "$ADSP";;
    running) :;;
    *) echo UNEXPECTED_ADSP_STATE; exit 3;;
esac
test "$(cat "$ADSP/state")" = running
timeout -k 1 6 systemctl start wpa_supplicant.service
timeout -k 1 3 systemctl is-active --quiet wpa_supplicant.service
timeout -k 1 4 busctl --system get-property fi.w1.wpa_supplicant1 /fi/w1/wpa_supplicant1 fi.w1.wpa_supplicant1 Interfaces
timeout -k 2 40 bash -c 'modprobe pwrseq_qcom_wcn; sleep 12; modprobe mhi; modprobe pci_pwrctrl_pwrseq; modprobe ath12k_wifi7'
for attempt in $(seq 1 15); do
    test -n "$(/usr/sbin/iw dev | awk '$1=="Interface"{print $2;exit}')" && break
    sleep 1
done
test -n "$(/usr/sbin/iw dev | awk '$1=="Interface"{print $2;exit}')"
echo QUALIFIED_WIFI_DRIVER_READY
if [ "$mode" = --all ]; then
    timeout -k 1 15 modprobe dodge-s3910
    timeout -k 1 6 systemctl start bluetooth
    timeout -k 1 6 /usr/sbin/erhai-bt-address --generate
    timeout -k 1 12 /usr/sbin/erhai-bt-address --apply --wait 8
    timeout -k 1 6 /usr/sbin/erhai-bt-address --power-on
    timeout -k 1 12 python3 /usr/libexec/oneplus13-ram-display-prerequisites.py --release "$PLATFORM_KERNEL_RELEASE" --sha256 "$CEC_MODULE_SHA256" --ubwc-sha256 "$UBWC_MODULE_SHA256" --policy-sha256 "$MODULE_POLICY_SHA256"
    python3 /run/oneplus13/native/start-native-display --check
    python3 /run/oneplus13/native/start-native-display --activate
    getent passwd a >/dev/null || { useradd -m -s /bin/bash -G adm,sudo a; echo 'a:a' | chpasswd; }
    install -d -m 0755 /var/lib/AccountsService/users
    cat > /var/lib/AccountsService/users/a <<'EOF'
[User]
Language=zh_CN.UTF-8
XSession=ubuntu
SystemAccount=false
EOF
    chmod 0600 /var/lib/AccountsService/users/a
    printf 'run_im ibus\n' > /home/a/.xinputrc
    chown a:a /home/a/.xinputrc
    runuser -u a -- dbus-run-session -- gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('ibus', 'libpinyin')]"
    runuser -u a -- dbus-run-session -- gsettings set org.gnome.system.locale region 'zh_CN'
    grep -q '^GSK_RENDERER=cairo$' /etc/environment || echo GSK_RENDERER=cairo >> /etc/environment
    python3 /usr/libexec/oneplus13-ram-desktop-check.py --configure
    timeout -k 1 6 systemctl restart gdm
    echo QUALIFIED_DESKTOP_TOUCH_BLUETOOTH_STARTED
fi
