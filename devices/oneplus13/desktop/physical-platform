#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Derived from the project's erhai-physical-platform; phone guards are separate.
set -eu
sysroot=${1:-/sys}
case "$sysroot" in /sys|/newroot/sys) ;; *) exit 2 ;; esac
base=$sysroot/firmware/devicetree/base
tr '\000' '\n' < "$base/compatible" | grep -qx oneplus,dodge
[ "$(tr '\000' '\n' < "$base/chassis-type")" = handset ]
hyper=$base/hypervisor
[ -d "$hyper" ] || exit 0
tr '\000' '\n' < "$hyper/compatible" | grep -qx qcom,gunyah-hypervisor
[ "$(od -An -tx1 "$hyper/qcom,gunyah-vm/qcom,vmid" | tr -d ' \n')" = 00000003 ]
for device in "$sysroot"/bus/platform/devices/hypervisor*; do
    [ ! -e "$device/driver" ] || { echo 'Hypervisor has a bound driver'; exit 1; }
done
mount -t tmpfs -o ro,nosuid,nodev,noexec,size=4k,mode=0555 oneplus13-physical-platform "$hyper"
echo 'ONEPLUS13_PHYSICAL_PLATFORM_EXPORT_CORRECTED'
