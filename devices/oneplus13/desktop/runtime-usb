#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Validate and retain the already bound phone gadget; never create another one.
set -eu
g=/sys/kernel/config/usb_gadget/oneplus13
[ "$(cat "$g/idVendor")" = 0x1d6b ]
[ "$(cat "$g/idProduct")" = 0x0104 ]
[ "$(cat "$g/functions/ncm.usb0/dev_addr")" = 02:13:00:00:00:01 ]
[ "$(cat "$g/functions/ncm.usb0/host_addr")" = 02:13:00:00:00:02 ]
iface=$(cat "$g/functions/ncm.usb0/ifname")
[ "$iface" = usb0 ]
[ "$(cat "/sys/class/net/$iface/address")" = 02:13:00:00:00:01 ]
udc=$(cat "$g/UDC")
case "$udc" in ''|*[!a-zA-Z0-9_.:-]*) exit 1 ;; esac
[ "$(cat "/sys/class/udc/$udc/function")" = oneplus13 ]
ip link set dev "$iface" up
ip address replace 172.16.13.1/24 dev "$iface"
mkdir -p /run/oneplus13 /run/evidence
printf 'start 172.16.13.2\nend 172.16.13.2\ninterface usb0\noption subnet 255.255.255.0\nlease_file /run/oneplus13/udhcpd.leases\n' > /run/oneplus13/udhcpd.conf
touch /run/oneplus13/udhcpd.leases
