[Unit]
Description=OnePlus 13 SN220 NXP NCI controller
After=systemd-modules-load.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/modprobe nxp_nci_i2c
ExecStart=/bin/sh -c 'for i in $(seq 1 40); do [ -e /sys/class/nfc/nfc0 ] && exit 0; sleep 0.25; done; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
