[Unit]
ConditionKernelCommandLine=oneplus13.desktop=1
ConditionPathExists=/run/oneplus13/ram-session
Description=OnePlus 13 lock and backlight power-key control (%I)
BindsTo=dev-input-%i.device
After=dev-input-%i.device systemd-logind.service
# Phone compatibility blanking keeps the KMS/SPR link running.
Wants=oneplus13-display-power.socket
After=oneplus13-display-power.socket
JobTimeoutSec=15
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/libexec/oneplus13-power-key.py /dev/input/%I
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
