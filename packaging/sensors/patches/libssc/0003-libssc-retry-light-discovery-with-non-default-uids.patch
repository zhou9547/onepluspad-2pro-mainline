From 5f8e0f653cb7b7e463efafce92a34b857f10bf4a Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 28 Oct 2026 01:04:00 +0800
Subject: [PATCH] libssc: retry light discovery with non-default UIDs

Some vendor sensor images publish android.sensor.light as a fused,
non-default sensor while still exposing the default ambient_light SUID
group.  libssc currently only asks for default UIDs, observes an empty
ambient_light response, and reports the sensor unavailable without trying
the non-default entries.

On the OnePlus 13 Android sensor service, the active light type is
"OPLUS Fusion Light Sensor Next Gen"; the tcs3720 high-PWM light sensor
and RGB sensor are separate vendor sensors.  The captured SSC registry
contains default_sensors.ambient_light, so the first default-only query is
still required.  Only when that query returns no UID, retry the same
ambient_light lookup once with only_default_values=false.

Keep the fallback limited to ambient_light and to one retry.  Every other
sensor type retains the existing default-only lookup and no sampling or
stream behavior changes.

diff --git a/src/libssc-sensor.c b/src/libssc-sensor.c
index e9ae08b..a91b8f6 100644
--- a/src/libssc-sensor.c
+++ b/src/libssc-sensor.c
@@ -63,5 +63,6 @@ typedef struct _SSCSensorPrivate {
 	gboolean service_available;
 	guint service_retries;
+	gboolean light_discover_all;
 } SSCSensorPrivate;
 
 static void async_initable_iface_init (GAsyncInitableIface *iface);
@@ -343,5 +344,15 @@ report_received (SSCClient *self, guint32 msg_id, guint64 uid_high, guint64 uid_low, GArray *buf, gpointer user_data)
 		/* No sensor available for specified data type, complete task */
 		} else {
+			if (g_strcmp0 (priv->data_type, "ambient_light") == 0 &&
+			    !priv->light_discover_all) {
+				priv->light_discover_all = TRUE;
+				g_debug ("No default 'ambient_light' sensor available; "
+					 "retrying with non-default UIDs");
+				ssc_suid_response__free_unpacked (suid_msg, NULL);
+				discover (ctx->sensor, ctx->task);
+				return;
+			}
+
 			g_debug ("No '%s' sensor available", priv->data_type);
 			ssc_suid_response__free_unpacked (suid_msg, NULL);
 
@@ -579,3 +579,3 @@ discover (SSCSensor *self, GTask *task)
 	msg.has_only_default_values = true;
-	msg.only_default_values = true;
+	msg.only_default_values = !priv->light_discover_all;
 
 	g_array_set_size (buf, ssc_suid_request__get_packed_size (&msg));
-- 
